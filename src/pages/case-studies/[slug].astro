---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { breadcrumbSchema, articleSchema } from '../../utils/jsonld';

export async function getStaticPaths() {
  const caseStudies = await getCollection('case-studies');
  return caseStudies.map((study) => ({
    params: { slug: study.slug },
    props: { study },
  }));
}

const { study } = Astro.props;
const { Content } = await study.render();

const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Case Studies', url: '/case-studies' },
    { name: study.data.title, url: `/case-studies/${study.slug}` }
  ]),
  articleSchema({
    title: study.data.title,
    description: study.data.description,
    url: `/case-studies/${study.slug}`,
    publishedDate: study.data.publishedDate.toISOString(),
  }),
];

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long'
  }).format(date);
}
---

<BaseLayout
  title={study.data.title}
  description={study.data.description}
  jsonLd={jsonLd}
  realmGlow="0.68 0.16 130"
  realmBg="0.10 0.02 150"
  realmText="0.98 0.02 150"
>
  <!-- Header -->
  <article>
  <header class="border-b border-white/5">
    <div class="container-wide section-padding-sm">
      <div class="max-w-4xl">
        <Breadcrumbs items={[
          { label: 'Home', href: '/' },
          { label: 'Case Studies', href: '/case-studies' },
          { label: study.data.title },
        ]} />
        
        <div class="flex flex-wrap items-center gap-4 mb-6">
          <span class="text-sm font-bold px-4 py-1 rounded-full bg-white/10 opacity-60 border border-white/10">
            {study.data.industry}
          </span>
          <time class="text-sm opacity-50">
            {formatDate(study.data.publishedDate)}
          </time>
        </div>
        
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold mb-8 tracking-tight leading-tight">
          {study.data.title}
        </h1>
        
        <p class="text-xl sm:text-2xl opacity-70 mb-8 max-w-3xl leading-relaxed">
          {study.data.description}
        </p>
        
        <div class="flex flex-wrap gap-3">
          {study.data.services.map((service) => (
            <a href="/services" class="text-sm px-4 py-1.5 rounded-full bg-brand-500/20 text-brand-400 border border-brand-500/30 hover:bg-brand-500/30 transition-colors">
              {service}
            </a>
          ))}
        </div>
      </div>
    </div>
  </header>

  <!-- Results Banner -->
  {study.data.results.length > 0 && (
    <section class="bg-white/5 border-y border-white/5 backdrop-blur-sm">
      <div class="container-wide py-12">
        <h2 class="text-xs font-bold text-brand-400 uppercase tracking-[0.3em] mb-8 text-center">
          Key Results
        </h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {study.data.results.map((result) => (
            <div class="bg-white/5 rounded-engine-inner p-6 border border-white/10 text-center shadow-engine-soft">
              <p class="font-medium opacity-90">{result}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Content -->
  <section class="container-narrow section-padding-sm">
    <div class="max-w-3xl mx-auto prose prose-invert prose-lg prose-headings:font-mono prose-headings:tracking-tight prose-a:text-warm-400">
      <Content />
    </div>
  </section>

  <!-- Testimonial -->
  {study.data.testimonial && (
    <section class="bg-white/5 border-y border-white/5 backdrop-blur-sm">
      <div class="container-narrow section-padding-sm">
        <div class="max-w-3xl mx-auto text-center">
          <svg class="w-12 h-12 mx-auto mb-8 text-brand-500/30" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
          </svg>
          <blockquote class="text-xl sm:text-2xl opacity-90 mb-8 italic leading-relaxed">
            "{study.data.testimonial.quote}"
          </blockquote>
          <div>
            <p class="font-bold">{study.data.testimonial.author}</p>
            <p class="text-sm opacity-50">{study.data.testimonial.role}</p>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="container-narrow section-padding-sm">
    <div class="max-w-3xl mx-auto border-t border-white/10 pt-12">
      <h2 class="text-2xl font-bold mb-3">Have a similar challenge?</h2>
      <p class="opacity-70 mb-6">
        Tell us what you're dealing with. We'll tell you what it takes to fix it.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="/contact" class="btn-primary">Get a Quote</a>
        <a href="/case-studies" class="btn-secondary">More Case Studies</a>
      </div>
    </div>
  </section>
  </article>
</BaseLayout>
