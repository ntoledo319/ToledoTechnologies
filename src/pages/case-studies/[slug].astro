---
import InsertLayout from '../../layouts/InsertLayout.astro';
import { getCollection } from 'astro:content';
import { breadcrumbSchema, articleSchema } from '../../utils/jsonld';

export async function getStaticPaths() {
  const caseStudies = await getCollection('case-studies');
  return caseStudies.map((study) => ({
    params: { slug: study.slug },
    props: { study }
  }));
}

const { study } = Astro.props;
const { Content } = await study.render();

const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Proof & Field Notes', url: '/case-studies' },
    { name: study.data.title, url: `/case-studies/${study.slug}` }
  ]),
  articleSchema({
    title: study.data.title,
    description: study.data.description,
    url: `/case-studies/${study.slug}`,
    publishedDate: study.data.publishedDate.toISOString()
  })
];

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long'
  }).format(date);
}

const evidenceLabel =
  study.data.evidenceType === 'independent-research'
    ? 'Independent research · not client work'
    : 'Sample deliverable · not client work';
---

<InsertLayout
  title={study.data.title}
  description={study.data.description}
  jsonLd={jsonLd}
  heading={study.data.title}
  subheading={study.data.description}
>
  <header class="mb-12 border-b border-black/5 pb-8">
    <div class="mb-6 flex flex-wrap items-center gap-4">
      <span class="text-sm font-medium tracking-widest uppercase opacity-65">
        {study.data.industry}
      </span>
      <time class="text-sm opacity-65">
        {formatDate(study.data.publishedDate)}
      </time>
    </div>

    <div class="flex flex-wrap gap-3">
      {
        study.data.services.map((service) => (
          <a
            href="/services"
            class="text-warm-500 hover:text-warm-600 text-sm transition-colors"
          >
            {service}
          </a>
        ))
      }
    </div>
  </header>

  <section class="evidence-band" aria-labelledby="evidence-label">
    <div>
      <p id="evidence-label" class="evidence-band-label">{evidenceLabel}</p>
      <p>{study.data.evidenceNote}</p>
    </div>
    <div>
      <p class="evidence-band-label">Limits</p>
      <p>{study.data.limitations}</p>
    </div>
  </section>

  {
    study.data.results.length > 0 && (
      <section class="mb-12 border-b border-black/5 pb-8">
        <h2
          class="text-warm-500 mb-8 text-xs font-bold tracking-[0.3em] uppercase"
          style="font-family: var(--font-lyric);"
        >
          Recorded evidence
        </h2>
        <div class="grid gap-8 sm:grid-cols-2">
          {study.data.results.map((result) => (
            <div>
              <p class="font-medium opacity-70">{result}</p>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <div class="prose prose-lg max-w-none">
    <Content />
  </div>

  <section class="mt-16 border-t border-black/5 pt-12">
    <h2 class="mb-3 text-2xl font-bold" style="font-family: var(--font-lyric);">
      Need the same question answered on your system?
    </h2>
    <p class="mb-6 opacity-50">
      Paid discovery produces a scoped document with explicit evidence and
      limitations. It does not begin with a promised outcome.
    </p>
    <div class="flex flex-wrap gap-4">
      <a href="/discovery#start" class="btn-primary">Choose a Discovery</a>
      <a href="/case-studies" class="btn-ghost">More Field Notes</a>
    </div>
  </section>
</InsertLayout>
