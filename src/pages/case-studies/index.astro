---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SampleDiscoveryInsert from '../../components/SampleDiscoveryInsert.astro';
import { getCollection } from 'astro:content';
import { breadcrumbSchema, itemListSchema } from '../../utils/jsonld';

const caseStudies = await getCollection('case-studies');
const sortedStudies = caseStudies.sort(
  (a, b) =>
    new Date(b.data.publishedDate).getTime() -
    new Date(a.data.publishedDate).getTime()
);

const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Proof & Field Notes', url: '/case-studies' }
  ]),
  itemListSchema(
    sortedStudies.map((s) => ({
      name: s.data.title,
      url: `/case-studies/${s.slug}`,
      description: s.data.description
    })),
    'Toledo Technologies Proof and Field Notes'
  )
];
---

<BaseLayout
  title="Proof & Field Notes"
  description="Dated research notes and sample deliverables from Toledo Technologies. Independent audits are labeled and are not presented as paid client work."
  jsonLd={jsonLd}
  realmGlow="0.68 0.16 130"
  realmBg="0.985 0.008 45"
  realmText="0.11 0.03 45"
>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-black/5">
    <div class="container-wide section-padding-sm relative z-10">
      <div class="max-w-4xl">
        <Breadcrumbs
          items={[
            { label: 'Home', href: '/' },
            { label: 'Proof & Field Notes' }
          ]}
        />
        <h1
          class="mb-6 text-5xl leading-[0.9] font-bold tracking-tight sm:text-7xl"
        >
          Proof &amp; <span class="text-brand-400 italic">Field Notes</span>
        </h1>
        <p class="max-w-2xl text-xl leading-relaxed opacity-50 sm:text-2xl">
          Inspect the evidence and its boundary. Every note below says where the
          data came from, what Toledo did not have access to, and whether a
          client relationship existed.
        </p>
      </div>
    </div>
  </section>

  <section class="container-wide pt-12 sm:pt-16">
    <SampleDiscoveryInsert />
  </section>

  <!-- Evidence notes -->
  <section class="container-wide section-padding-sm">
    <div class="divide-y divide-black/5">
      {
        sortedStudies.map((study, index) => (
          <a
            href={`/case-studies/${study.slug}`}
            class:list={[
              'group hover:text-brand-400 block py-12 transition-all duration-300',
              index === 0 && 'pt-0'
            ]}
          >
            <div class="mb-4 flex items-center gap-4">
              <span class="text-sm font-medium tracking-widest uppercase opacity-60">
                {study.data.evidenceType === 'independent-research'
                  ? 'Independent research'
                  : 'Sample deliverable'}{' '}
                · {study.data.industry}
              </span>
              {study.data.featured && (
                <span class="text-brand-400 text-xs font-bold tracking-widest uppercase">
                  Selected note
                </span>
              )}
            </div>

            <h2 class="group-hover:text-brand-400 mb-4 text-2xl leading-tight font-bold transition-colors sm:text-3xl">
              {study.data.title}
            </h2>

            <p class="mb-6 max-w-2xl text-lg leading-relaxed opacity-50 transition-opacity group-hover:opacity-70">
              {study.data.description}
            </p>

            <p class="mb-6 max-w-3xl font-mono text-xs leading-relaxed tracking-wide uppercase opacity-70">
              {study.data.evidenceNote}
            </p>

            {study.data.results.length > 0 && (
              <div class="mb-6">
                <ul class="flex flex-wrap gap-x-6 gap-y-2">
                  {study.data.results.slice(0, 3).map((result) => (
                    <li class="flex items-center gap-2 text-sm opacity-65">
                      <span class="text-brand-400">→</span>
                      <span>{result}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <div class="flex flex-wrap gap-3">
              {study.data.services.map((service) => (
                <span class="text-xs opacity-60">{service}</span>
              ))}
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-black/5">
    <div class="container-wide section-padding-sm">
      <div class="max-w-4xl">
        <h2 class="mb-4 text-3xl font-bold">Need a comparable diagnosis?</h2>
        <p class="mb-8 text-lg opacity-50">
          Start with the smallest discovery that can turn the unknowns into a
          dated, usable document.
        </p>
        <a href="/discovery#start" class="btn-primary shadow-engine-glow"
          >Choose a Discovery</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
