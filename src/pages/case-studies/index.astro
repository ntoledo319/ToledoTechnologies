---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { breadcrumbSchema, itemListSchema } from '../../utils/jsonld';

const caseStudies = await getCollection('case-studies');
const sortedStudies = caseStudies.sort((a, b) => 
  new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime()
);

const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Case Studies', url: '/case-studies' }
  ]),
  itemListSchema(
    sortedStudies.map(s => ({
      name: s.data.title,
      url: `/case-studies/${s.slug}`,
      description: s.data.description
    })),
    'Case Studies'
  )
];
---

<BaseLayout
  title="Case Studies"
  description="Real projects, real results. See how we've helped clients with MVP development, bug fixes, legacy system rescues, and more."
  jsonLd={jsonLd}
  realmGlow="0.68 0.16 130"
  realmBg="0.10 0.02 150"
  realmText="0.98 0.02 150"
>
  <!-- Hero -->
  <section class="border-b border-white/5 relative overflow-hidden">
    <div class="container-wide section-padding-sm relative z-10">
      <div class="max-w-4xl">
        <Breadcrumbs items={[
          { label: 'Home', href: '/' },
          { label: 'Case Studies' },
        ]} />
        <h1 class="text-5xl sm:text-7xl font-bold mb-6 tracking-tight leading-[0.9]">
          Case <span class="text-brand-400 italic">Studies</span>
        </h1>
        <p class="text-xl sm:text-2xl opacity-70 max-w-2xl leading-relaxed">
          Real projects, real results. Here's how we've helped clients ship software, 
          fix problems, and build systems that work.
        </p>
      </div>
    </div>
  </section>

  <!-- Case Studies Grid -->
  <section class="container-wide section-padding-sm">
    <div class="grid md:grid-cols-2 gap-8">
      {sortedStudies.map((study) => (
        <a 
          href={`/case-studies/${study.slug}`}
          class="card-interactive p-8 group"
        >
          <div class="flex items-center gap-4 mb-6">
            <span class="text-sm font-bold px-3 py-1 rounded-full bg-white/10 opacity-60 border border-white/10">
              {study.data.industry}
            </span>
            {study.data.featured && (
              <span class="text-sm font-bold px-3 py-1 rounded-full bg-brand-500/20 text-brand-400 border border-brand-500/30">
                Featured
              </span>
            )}
          </div>
          
          <h2 class="text-2xl font-bold group-hover:text-brand-400 transition-colors mb-4 leading-tight">
            {study.data.title}
          </h2>
          
          <p class="text-lg opacity-70 mb-8 leading-relaxed">
            {study.data.description}
          </p>
          
          {study.data.results.length > 0 && (
            <div class="mb-8">
              <h3 class="text-xs font-bold opacity-40 uppercase tracking-widest mb-4">
                Key Results
              </h3>
              <ul class="space-y-2">
                {study.data.results.slice(0, 3).map((result) => (
                  <li class="flex items-start gap-3 text-sm">
                    <svg class="w-4 h-4 text-brand-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span class="opacity-80">{result}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
          
          <div class="flex flex-wrap gap-2">
            {study.data.services.map((service) => (
              <span class="text-xs px-3 py-1 rounded-full bg-white/10 opacity-50 border border-white/10">
                {service}
              </span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="container-wide section-padding-sm">
    <div class="max-w-4xl mx-auto text-center p-16 rounded-engine bg-surface-900/40 backdrop-blur-md border border-white/10 shadow-engine-glow">
      <h2 class="text-4xl font-bold mb-6">Have a similar problem?</h2>
      <p class="text-xl opacity-70 mb-10 max-w-2xl mx-auto leading-relaxed">
        Every project starts with a conversation. Tell us what you're working on.
      </p>
      <a href="/contact" class="btn-primary text-xl px-12 py-5 shadow-engine-glow">Get a Quote</a>
    </div>
  </section>
</BaseLayout>
