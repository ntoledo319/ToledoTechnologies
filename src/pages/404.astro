---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404"
  description="Page not found."
  noindex={true}
  realmGlow="0.60 0.15 25"
  realmBg="0.985 0.008 45"
  realmText="0.11 0.03 45"
>
  <section class="container-wide section-padding">
    <div class="mx-auto max-w-2xl">
      <div class="mb-10 text-sm opacity-40">
        <div class="mb-4">$ curl -I toledotech.com{Astro.url.pathname}</div>
        <div class="text-surface-900 text-lg font-bold">
          HTTP/1.1 <span class="text-warm-500">404 Not Found</span>
        </div>
        <div>content-type: text/html</div>
        <div>x-powered-by: coffee, deadlines</div>
        <div class="mt-4 opacity-40">
          // This page doesn't exist. We checked.
        </div>
      </div>

      <h1 class="mb-4 text-4xl font-bold">Nothing here.</h1>
      <p class="mb-10 text-xl leading-relaxed opacity-50">
        The page you're looking for was either moved, deleted, or never existed.
        Here's where you probably meant to go:
      </p>

      <div class="space-y-4">
        <a
          href="/"
          class="group flex items-center justify-between border-b border-black/5 py-4 opacity-50 transition-all hover:opacity-100"
        >
          <span class="text-lg font-medium">Home</span>
          <span
            class="transform opacity-20 transition-all group-hover:translate-x-2 group-hover:opacity-100"
            >→</span
          >
        </a>
        <a
          href="/services"
          class="group flex items-center justify-between border-b border-black/5 py-4 opacity-50 transition-all hover:opacity-100"
        >
          <span class="text-lg font-medium">Services</span>
          <span
            class="transform opacity-20 transition-all group-hover:translate-x-2 group-hover:opacity-100"
            >→</span
          >
        </a>
        <a
          href="/codebases"
          class="group flex items-center justify-between border-b border-black/5 py-4 opacity-50 transition-all hover:opacity-100"
        >
          <span class="text-lg font-medium">Codebases</span>
          <span
            class="transform opacity-20 transition-all group-hover:translate-x-2 group-hover:opacity-100"
            >→</span
          >
        </a>
        <a
          href="/contact"
          class="group flex items-center justify-between border-b border-black/5 py-4 opacity-50 transition-all hover:opacity-100"
        >
          <span class="text-lg font-medium">Contact</span>
          <span
            class="transform opacity-20 transition-all group-hover:translate-x-2 group-hover:opacity-100"
            >→</span
          >
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
