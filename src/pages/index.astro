---
import GatefoldLayout from '../layouts/GatefoldLayout.astro';
import {
  organizationSchema,
  websiteSchema,
  professionalServiceSchema
} from '../utils/jsonld';
import LinerNotes from '../components/home/LinerNotes.astro';
import HomeCTA from '../components/home/HomeCTA.astro';
import SideAFooter from '../components/home/SideAFooter.astro';

const jsonLd = [
  organizationSchema(),
  websiteSchema(),
  professionalServiceSchema()
];
---

<GatefoldLayout
  title="Home"
  description="Toledo Technologies builds, fixes, and ships the software that runs underneath your business. Senior-led development for editorial websites, custom apps, and governed AI. No agency theatre. Just code that lasts."
  jsonLd={jsonLd}
>
  <article
    id="insert-side-a"
    class="insert active"
    data-label="Side A — Liner Notes"
  >
    <LinerNotes />
    <HomeCTA />
    <SideAFooter />
  </article>
</GatefoldLayout>

<style>
  /* On the home page the .endsleeve at the bottom of the Side A insert
     serves as the printed footer of the record. Hide the global site
     <Footer /> here to avoid the duplication; the sticky Header stays
     because it carries the cross-side navigation. */
  :global(.paper-stage > footer) {
    display: none;
  }
  :global(.paper-stage #main-content) {
    padding-top: 32px;
  }

  .insert {
    position: relative;
    padding: 0;
  }
</style>
