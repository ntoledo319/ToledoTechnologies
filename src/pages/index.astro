---
import BaseLayout from '../layouts/BaseLayout.astro';
import { organizationSchema, websiteSchema } from '../utils/jsonld';

const jsonLd = [organizationSchema(), websiteSchema()];

const services = [
  {
    title: 'Fix & Improve',
    description: 'Bug fixes, performance optimization, and refactoring. We clean up the mess.',
    href: '/services#fix',
  },
  {
    title: 'Build Features',
    description: 'New features, integrations, and MVPs. From concept to shipped.',
    href: '/services#build',
  },
  {
    title: 'Automate',
    description: 'Scripts, pipelines, and AI workflows. Make the tedious disappear.',
    href: '/services#automate',
  },
  {
    title: 'Buy Codebases',
    description: 'Deploy-ready repositories for security, compliance, and ops.',
    href: '/codebases',
  },
];

---

<BaseLayout
  title="Home"
  description="Toledo Technologies is a remote software development studio. We build, fix, and ship code—fast. Bug fixes, feature implementation, automation, and deploy-ready codebases."
  jsonLd={jsonLd}
>
  <!-- Hero: no gradients, no decoration, just the pitch -->
  <section class="border-b border-surface-200">
    <div class="container-wide section-padding">
      <div class="max-w-3xl">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-surface-900 mb-6 tracking-tight">
          We build, fix, and ship code—fast.
        </h1>
        <p class="text-xl text-surface-600 mb-8 max-w-2xl">
          Remote software development studio. Bug fixes, feature builds, automation,
          and deploy-ready codebases you can own outright.
        </p>

        <div class="flex flex-wrap gap-3">
          <a href="/contact?subject=Bug%20Fix" class="btn-primary text-base px-6 py-3">
            Fix My Broken Thing
          </a>
          <a href="/contact" class="btn-secondary text-base px-6 py-3">
            Get a Quote
          </a>
          <a href="/codebases" class="btn-ghost text-base px-6 py-3">
            Browse Codebases →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- What We Do: list, not card grid -->
  <section class="border-b border-surface-200">
    <div class="container-wide section-padding-sm">
      <h2 class="text-2xl font-bold text-surface-900 mb-8">What We Do</h2>
      <div class="grid md:grid-cols-2 gap-x-12 gap-y-6">
        {services.map((service) => (
          <a href={service.href} class="group py-4 border-b border-surface-100 last:border-0 flex justify-between items-start gap-4">
            <div>
              <h3 class="font-mono font-semibold text-surface-900 group-hover:text-warm-500 transition-colors">
                {service.title}
              </h3>
              <p class="text-sm text-surface-600 mt-1">{service.description}</p>
            </div>
            <span class="text-surface-400 group-hover:text-warm-500 transition-colors mt-1 shrink-0">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Proof + Nonprofit: two-column, asymmetric -->
  <section class="border-b border-surface-200">
    <div class="container-wide section-padding-sm">
      <div class="grid lg:grid-cols-3 gap-6">
        <!-- GitHub -->
        <div class="lg:col-span-2 bg-surface-900 rounded-md p-8 text-white">
          <div class="flex items-center gap-3 mb-4">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
            <h2 class="text-xl font-bold">Open Source</h2>
          </div>
          <p class="text-surface-400 mb-4">
            Check out our public work and contributions.
          </p>
          <a
            href="https://github.com/ntoledo319"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-white font-mono text-sm hover:text-brand-300 transition-colors"
          >
            github.com/ntoledo319 →
          </a>
        </div>

        <!-- Daedalus Landed -->
        <div class="bg-warm-50 border border-warm-200 rounded-md p-8">
          <h2 class="text-lg font-bold text-surface-900 mb-2">Daedalus Landed</h2>
          <p class="text-surface-700 text-sm mb-4">
            Our nonprofit initiative building free, humane AI for mental health, creation, and education.
          </p>
          <a href="/nonprofit" class="text-warm-600 hover:text-warm-700 font-mono text-sm transition-colors">
            Learn more →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Promise: direct, no-nonsense -->
  <section class="border-b border-surface-200">
    <div class="container-wide section-padding-sm">
      <div class="max-w-3xl">
        <h2 class="text-2xl font-bold text-surface-900 mb-4">What We Actually Promise</h2>
        <p class="text-lg text-surface-600 mb-6">
          Transparent communication, clean code, and work that ships on time.
          If something's going sideways, you'll know immediately—not after the deadline passes.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/case-studies" class="btn-secondary">
            See Our Work
          </a>
          <a href="/contact" class="btn-primary">
            Start a Conversation
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
