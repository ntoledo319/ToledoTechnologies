---
import InsertLayout from '../layouts/InsertLayout.astro';
import { breadcrumbSchema, serviceSchema } from '../utils/jsonld';

const services = [
  {
    name: 'ToledoWeb',
    description: 'Custom websites, editorial design, and bespoke builds.'
  },
  {
    name: 'SiteLift',
    description: 'Productized migrations off WordPress, Squarespace, and Wix.'
  },
  {
    name: 'Toledo Apps',
    description: 'Custom software, web apps, and enterprise SaaS.'
  },
  { name: 'Toledo Mobile', description: 'Native iOS and Android apps.' },
  { name: 'Toledo AI', description: 'AI agents and workflow automation.' }
];

const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Services', url: '/services' }
  ]),
  serviceSchema(services)
];
---

<InsertLayout
  title="Services"
  description="The Catalog of Toledo Technologies. Five sides of the studio: Custom Websites, WordPress Exits, Web Apps & SaaS, Native Mobile, and AI Agents."
  jsonLd={jsonLd}
  heading="Five sides of the catalog. One studio behind all of them."
  subheading="The work splits five ways. Each side has its own microsite — its own identity, its own pricing, its own discovery product, and its own front door. Choose the track you need. If you aren't sure where you belong, start with Discovery."
>
  <p class="eyebrow" style="margin-bottom: 24px;">
    <span class="num">A2</span><span class="bar"></span><span>The Catalog</span>
  </p>

  <div
    class="catalog-grid"
    style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px; margin-bottom: 64px;"
  >
    <div
      class="catalog-card"
      style="border: 1px solid var(--gf-ink-200); padding: 24px; display: flex; flex-direction: column;"
    >
      <h3>ToledoWeb — Custom websites</h3>
      <p style="font-style: italic; font-size: 14px; margin-top: -8px;">
        Websites that don't look like everyone else's.
      </p>
      <ul
        style="list-style: none; padding: 0; font-size: 15px; margin: 16px 0;"
      >
        <li><strong>Range:</strong> $5,500 – $250,000+</li>
        <li>
          <strong>Discovery:</strong>
          <a href="/discovery#website-audit">Website Migration Audit ($1,500)</a
          >
        </li>
        <li><strong>Best for:</strong> Founders, design-led brands</li>
      </ul>
      <a
        href="https://web.toledotechnologies.com"
        style="margin-top: auto; font-weight: bold;"
        >→ web.toledotechnologies.com</a
      >
    </div>

    <div
      class="catalog-card"
      style="border: 1px solid var(--gf-ink-200); padding: 24px; display: flex; flex-direction: column;"
    >
      <h3>SiteLift — WordPress exits</h3>
      <p style="font-style: italic; font-size: 14px; margin-top: -8px;">
        WordPress is the monthly drag. SiteLift is the clean exit.
      </p>
      <ul
        style="list-style: none; padding: 0; font-size: 15px; margin: 16px 0;"
      >
        <li><strong>Range:</strong> $3,500 – $65,000+</li>
        <li>
          <strong>Discovery:</strong>
          <a href="/discovery#sitelift-fit-check">SiteLift Fit Check ($750)</a>
        </li>
        <li>
          <strong>Best for:</strong> Businesses bleeding money on WP maintenance
        </li>
      </ul>
      <a
        href="https://sitelift.toledotechnologies.com"
        style="margin-top: auto; font-weight: bold;"
        >→ sitelift.toledotechnologies.com</a
      >
    </div>

    <div
      class="catalog-card"
      style="border: 1px solid var(--gf-ink-200); padding: 24px; display: flex; flex-direction: column;"
    >
      <h3>Toledo Apps — Web apps + SaaS</h3>
      <p style="font-style: italic; font-size: 14px; margin-top: -8px;">
        Custom apps, forged around your business.
      </p>
      <ul
        style="list-style: none; padding: 0; font-size: 15px; margin: 16px 0;"
      >
        <li><strong>Range:</strong> $15,000 – $750,000+</li>
        <li>
          <strong>Discovery:</strong>
          <a href="/discovery#web-app-discovery"
            >Delphi App Discovery ($3,500–$5,000)</a
          >
        </li>
        <li>
          <strong>Best for:</strong> Operations leaders, ops-heavy businesses
        </li>
      </ul>
      <a
        href="https://apps.toledotechnologies.com"
        style="margin-top: auto; font-weight: bold;"
        >→ apps.toledotechnologies.com</a
      >
    </div>

    <div
      class="catalog-card"
      style="border: 1px solid var(--gf-ink-200); padding: 24px; display: flex; flex-direction: column;"
    >
      <h3>Toledo Mobile — Native + cross-platform</h3>
      <p style="font-style: italic; font-size: 14px; margin-top: -8px;">
        Native app discovery for serious product teams.
      </p>
      <ul
        style="list-style: none; padding: 0; font-size: 15px; margin: 16px 0;"
      >
        <li><strong>Range:</strong> $50,000 – $700,000+</li>
        <li>
          <strong>Discovery:</strong>
          <a href="/discovery#mobile-discovery"
            >Delphi Mobile Discovery ($5,000–$7,500)</a
          >
        </li>
        <li><strong>Best for:</strong> Product owners, consumer brands</li>
      </ul>
      <a
        href="https://mobile.toledotechnologies.com"
        style="margin-top: auto; font-weight: bold;"
        >→ mobile.toledotechnologies.com</a
      >
    </div>

    <div
      class="catalog-card"
      style="border: 1px solid var(--gf-ink-200); padding: 24px; display: flex; flex-direction: column;"
    >
      <h3>Toledo AI — Agents + automation</h3>
      <p style="font-style: italic; font-size: 14px; margin-top: -8px;">
        Governed automation, agent systems, and production AI.
      </p>
      <ul
        style="list-style: none; padding: 0; font-size: 15px; margin: 16px 0;"
      >
        <li><strong>Range:</strong> $10,000 – $300,000+</li>
        <li>
          <strong>Discovery:</strong>
          <a href="/discovery#ai-blueprint"
            >AI Automation Blueprint ($3,500–$10,000)</a
          >
        </li>
        <li>
          <strong>Best for:</strong> Businesses that need autonomous systems with governance
        </li>
      </ul>
      <a
        href="https://ai.toledotechnologies.com"
        style="margin-top: auto; font-weight: bold;"
        >→ ai.toledotechnologies.com</a
      >
    </div>
  </div>

  <hr />

  <h2>What sits across the catalog</h2>
  <p>
    Three things don't belong to a single microsite because they cut across all
    five.
  </p>

  <h3>Care plans — <em>one maintenance ladder</em></h3>
  <p>
    Whatever we ship, we maintain. Basic Care at $750/mo for static sites
    through Strategic Growth at $10,000+/mo for fractional engineering on
    production systems. Plus pure-dev Starter / Growth / Scale buckets if you'd
    rather buy hours than service.
  </p>
  <p><a href="/care">→ See the full ladder</a></p>

  <h3>Discovery products — <em>six paid front doors</em></h3>
  <p>
    Two are productized fixed-price — SiteLift Fit Check ($750) and Website
    Migration Audit ($1,500). Four are quote-based within published bands — Web
    App Discovery, AI Automation Blueprint, Mobile App Discovery, and SaaS /
    Product Strategy. The hub sorts you onto the right one.
  </p>
  <p><a href="/discovery">→ See all six discoveries</a></p>

  <h3>Toledo Partner — <em>white-label for agencies</em></h3>
  <p>
    $125/hr floor, $150–$175/hr for complex work, retainer buckets from
    $1,500/mo. Non-compete, full IP assignment, your-name-on-the-PR-not-ours. We
    can join your Slack or stay invisible.
  </p>
  <p><a href="/partner">→ Inquire as a partner</a></p>

  <hr />

  <h2>Other shelves on Side B</h2>

  <p>
    <strong>Codebases for sale.</strong> Pre-built, documented, tested repositories
    you own outright. Buy and deploy.<br /><a href="/codebases"
      >→ Browse the shelf</a
    >
  </p>
  <p>
    <strong>The Rescue — case studies.</strong> Systems we pulled out of the fire.
    Numbers, timelines, and what changed.<br /><a href="/case-studies"
      >→ /case-studies</a
    >
  </p>
  <p>
    <strong>Nonprofit pricing.</strong> 501(c)(3) and mission-driven organizations
    get hard-floor pricing on Signal through Studio, plus reduced-rate Care plans.
    The trade is a written case study and a 2-minute testimonial.<br /><a
      href="/nonprofit">→ /nonprofit</a
    >
  </p>

  <hr />

  <h2>How a project starts</h2>

  <p>
    The first call is fifteen to thirty minutes. We talk about what you need,
    what you've tried, and what good looks like. By the end you'll know which
    microsite or discovery you belong in, what the band is, and when we could
    start.
  </p>

  <p>
    Most projects then move into a paid discovery — that's where we map the
    actual scope and produce a fixed-price quote. Discovery isn't a sales pitch
    dressed up; it's real work that produces a document you can use whether or
    not you hire us. Half the discovery fee credits toward the project deposit
    if you proceed within thirty days.
  </p>

  <p>
    If you want to skip the call, every microsite has its own inquiry form. They
    take five minutes and you get a real reply within a business day.
  </p>

  <p>
    <a href="/contact">Write us a letter →</a> · <a
      href="#section-1-the-catalog">Skip to a microsite →</a
    >
  </p>
</InsertLayout>
