---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { breadcrumbSchema, serviceSchema, faqSchema } from '../utils/jsonld';

const services = [
  {
    name: 'Fix & Improve',
    description: 'Bug fixes, performance optimization, refactoring, and code cleanup.'
  },
  {
    name: 'Build Features',
    description: 'New features, integrations, MVPs, and complete applications.'
  },
  {
    name: 'Automation',
    description: 'Scripts, CI/CD pipelines, AI workflows, and process automation.'
  },
  {
    name: 'Codebase Sales',
    description: 'Deploy-ready repositories for security, compliance, and operations.'
  },
  {
    name: 'Nonprofit Support',
    description: 'Technology tools and workflows for nonprofit organizations.'
  }
];

const faqs = [
  {
    question: 'How do you price your work?',
    answer: 'We offer both fixed-price projects and hourly rates depending on scope clarity. Fixed-price works best when requirements are well-defined. Hourly is better for exploratory work or ongoing support. We\'ll recommend the best fit during scoping.'
  },
  {
    question: 'What are typical timelines?',
    answer: 'It varies significantly by scope. Bug fixes can be same-day. Features typically take 1-4 weeks. MVPs run 4-12 weeks. We provide timeline estimates during scoping and communicate proactively if anything changes.'
  },
  {
    question: 'Who owns the code?',
    answer: 'You do. All custom work becomes your intellectual property upon payment. For codebases, you receive a perpetual license with full rights to modify, deploy, and build upon.'
  },
  {
    question: 'Do you offer maintenance?',
    answer: 'Yes. We offer ongoing support and maintenance packages for work we\'ve delivered. We can also take over maintenance of existing systems we didn\'t build.'
  },
  {
    question: 'Are you open to NDAs?',
    answer: 'Absolutely. We\'re comfortable signing NDAs before discussing sensitive projects. Confidentiality is standard practice for us.'
  },
  {
    question: 'What technologies do you work with?',
    answer: 'We\'re language and framework agnostic. Most commonly: TypeScript, Python, Go, React, Node.js, PostgreSQL, AWS, GCP. But we adapt to your stack—that\'s kind of the point.'
  }
];

const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Services', url: '/services' }
  ]),
  serviceSchema(services),
  faqSchema(faqs)
];

const serviceCategories = [
  {
    id: 'fix',
    title: 'Fix & Improve',
    tagline: 'Clean up the mess',
    description: 'Bug fixes, performance optimization, refactoring, and security patches. We diagnose issues properly and fix root causes, not just symptoms.',
    items: [
      'Bug diagnosis and fixes',
      'Performance optimization',
      'Code refactoring',
      'Security vulnerability patches',
      'Database query optimization',
      'Memory leak resolution',
      'Dependency updates',
      'Technical debt reduction'
    ]
  },
  {
    id: 'build',
    title: 'Build',
    tagline: 'From concept to shipped',
    description: 'New features, complete applications, MVPs, and integrations. We build what you need and hand it off clean.',
    items: [
      'Feature implementation',
      'MVP development',
      'API development',
      'Third-party integrations',
      'Frontend development',
      'Backend services',
      'Database design',
      'Full-stack applications'
    ]
  },
  {
    id: 'automate',
    title: 'Automate',
    tagline: 'Make the tedious disappear',
    description: 'Scripts, pipelines, and AI workflows. If you\'re doing something manually that a computer could do, we can fix that.',
    items: [
      'CI/CD pipeline setup',
      'Deployment automation',
      'Data processing scripts',
      'AI/ML workflow integration',
      'Report generation',
      'Notification systems',
      'Infrastructure as Code',
      'Scheduled task automation'
    ]
  },
  {
    id: 'codebases',
    title: 'Codebase Sales',
    tagline: 'Deploy-ready repositories',
    description: 'Pre-built, documented, tested codebases ready for deployment. Security, compliance, and operational tooling you can own outright.',
    items: [
      'Security audit tracking',
      'Compliance evidence collection',
      'Infrastructure testing tools',
      'Admin dashboards',
      'API starter kits',
      'Authentication systems',
      'Monitoring solutions',
      'Internal tools'
    ],
    cta: {
      text: 'Browse Available Codebases',
      href: '/codebases'
    }
  },
  {
    id: 'nonprofit',
    title: 'Nonprofit Support',
    tagline: 'Value on limited budgets',
    description: 'We help nonprofit organizations get technology value without enterprise pricing. Practical solutions that respect constraints.',
    items: [
      'Donor management systems',
      'Volunteer coordination tools',
      'Website development',
      'Process automation',
      'Data cleanup and migration',
      'Training and documentation',
      'Tool selection consulting',
      'Grant technology support'
    ],
    cta: {
      text: 'Learn About Nonprofit Work',
      href: '/nonprofit'
    }
  }
];
---

<BaseLayout
  title="Services"
  description="Software development services including bug fixes, feature implementation, automation, MVP development, and deploy-ready codebases. Remote software developer for hire."
  jsonLd={jsonLd}
  realmGlow="0.66 0.20 280"
  realmBg="0.10 0.01 240"
  realmText="0.98 0.01 240"
>
  <!-- Hero: Precise & Professional -->
  <section class="border-b border-white/5 relative overflow-hidden">
    <div class="container-wide section-padding relative z-10">
      <div class="max-w-4xl">
        <Breadcrumbs items={[
          { label: 'Home', href: '/' },
          { label: 'Services' },
        ]} />
        <h1 class="text-5xl sm:text-7xl font-bold mb-8 tracking-tight">
          High-Craft <span class="text-brand-400">Engineering.</span>
        </h1>
        <p class="text-xl sm:text-2xl opacity-70 mb-12 max-w-2xl leading-relaxed">
          You tell us what's broken, missing, or slow. We fix it, build it, or automate it. 
          Professional grade work, every single time.
        </p>
        <div class="flex flex-wrap gap-6">
          <a href="/contact" class="btn-primary text-lg px-10 py-4 shadow-engine-glow">
            Get a Quote
          </a>
          <a href="#fix" class="btn-secondary text-lg px-10 py-4">
            Jump to Services
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Categories: Tactical Grid -->
  <section class="container-wide section-padding-sm">
    <div class="space-y-24">
      {serviceCategories.map((category) => (
        <div id={category.id} class="scroll-mt-32 group">
          <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
            <div class="relative">
              <span class="text-brand-400 font-mono font-bold text-sm uppercase tracking-[0.2em] mb-4 block">
                {category.tagline}
              </span>
              <h2 class="text-4xl sm:text-5xl font-bold mb-6 tracking-tight">
                {category.title}
              </h2>
              <p class="text-xl opacity-70 mb-8 leading-relaxed max-w-xl">
                {category.description}
              </p>
              {category.cta && (
                <a href={category.cta.href} class="btn-primary text-base px-8 py-3">
                  {category.cta.text}
                </a>
              )}
              
              <!-- Subtle Background Light for Category -->
              <div class="absolute -top-20 -left-20 w-64 h-64 bg-[radial-gradient(circle_at_center,oklch(0.66_0.20_280_/_0.03),transparent_70%)] pointer-events-none group-hover:scale-150 transition-transform duration-1000"></div>
            </div>
            <div class="bg-white/5 backdrop-blur-md rounded-engine p-10 border border-white/10 shadow-engine-soft group-hover:border-brand-500/30 transition-all duration-700">
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                {category.items.map((item) => (
                  <li class="flex items-start gap-4">
                    <svg class="w-6 h-6 text-brand-500 mt-1 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span class="text-lg opacity-80 group-hover:opacity-100 transition-opacity">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ Section: Immersive List -->
  <section class="bg-white/5 border-y border-white/5 backdrop-blur-md">
    <div class="container-wide section-padding">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-4xl font-bold mb-16 text-center">
          Frequently Asked Questions
        </h2>
        <div class="grid md:grid-cols-2 gap-8">
          {faqs.map((faq) => (
            <div class="bg-white/5 rounded-engine-inner p-8 border border-white/10 hover:border-brand-500/30 transition-all duration-500">
              <h3 class="text-xl font-bold mb-4">{faq.question}</h3>
              <p class="opacity-70 leading-relaxed text-base">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA: Final Push -->
  <section class="container-wide section-padding">
    <div class="max-w-4xl mx-auto text-center p-16 rounded-engine bg-surface-900/40 backdrop-blur-md border border-white/10 shadow-engine-glow">
      <h2 class="text-4xl font-bold mb-6">Have something specific?</h2>
      <p class="text-xl opacity-70 mb-10 max-w-2xl mx-auto leading-relaxed">
        Tell us what you need. We'll scope it, price it, and get to work. 
        High-performance partnership starts with a conversation.
      </p>
      <a href="/contact" class="btn-primary text-xl px-12 py-5 shadow-engine-glow">
        Start a Conversation
      </a>
    </div>
  </section>
</BaseLayout>
