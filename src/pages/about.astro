---
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbSchema } from '../utils/jsonld';

const jsonLd = breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'About', url: '/about' }
]);

const values = [
  {
    title: 'Ship Clean',
    description: 'Code should work, be readable, and be maintainable. We don\'t cut corners that create future pain.'
  },
  {
    title: 'Communicate Clearly',
    description: 'No jargon walls. No disappearing acts. If there\'s a problem, you know immediately.'
  },
  {
    title: 'Respect Constraints',
    description: 'Budget, timeline, technical debt—we work within reality, not against it.'
  },
  {
    title: 'Stay Curious',
    description: 'Technology moves fast. We stay current without chasing every shiny thing.'
  }
];
---

<BaseLayout
  title="About"
  description="Toledo Technologies is a remote software development studio. We build, fix, and ship code with transparency and precision. Learn about our approach and values."
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="border-b border-surface-200">
    <div class="container-wide section-padding">
      <div class="max-w-3xl">
        <h1 class="text-4xl sm:text-5xl font-bold text-surface-900 mb-6">
          A dev shop that ships.
        </h1>
        <p class="text-xl text-surface-600">
          Remote studio. No project managers, no account executives. You talk to
          the people writing the code. We build, fix, and ship—then get out of the way.
        </p>
      </div>
    </div>
  </section>

  <!-- Story -->
  <section class="container-wide section-padding-sm">
    <div class="grid lg:grid-cols-2 gap-12 items-start">
      <div>
        <h2 class="text-2xl font-bold text-surface-900 mb-4">The Short Version</h2>
        <div class="space-y-4 text-surface-600">
          <p>
            Toledo Technologies exists because too many development projects end in frustration. 
            Scope creep. Poor communication. Code that works once but falls apart at scale.
          </p>
          <p>
            We do things differently. Clear scoping upfront. Regular communication throughout. 
            Clean code that gets handed off with documentation, not excuses.
          </p>
          <p>
            We work remotely, which means lower overhead and the ability to work with clients 
            anywhere. It also means we've built the discipline to deliver without needing 
            someone looking over our shoulder.
          </p>
        </div>
      </div>
      <div class="bg-surface-50 rounded-md p-8 border border-surface-200">
        <h3 class="font-semibold text-surface-900 mb-4">What We're Good At</h3>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <span class="text-warm-500 mt-1">→</span>
            <span class="text-surface-700">Fixing things that other developers broke (or that entropy broke)</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-warm-500 mt-1">→</span>
            <span class="text-surface-700">Building features and MVPs quickly without sacrificing quality</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-warm-500 mt-1">→</span>
            <span class="text-surface-700">Automating the tedious stuff so humans can focus on what matters</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-warm-500 mt-1">→</span>
            <span class="text-surface-700">Explaining technical decisions in plain language</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-warm-500 mt-1">→</span>
            <span class="text-surface-700">Handing off code that the next developer won't curse at</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="border-y border-surface-200">
    <div class="container-wide section-padding-sm">
      <h2 class="text-2xl font-bold text-surface-900 mb-6">How We Work</h2>
      <div class="grid md:grid-cols-2 gap-x-12 gap-y-4">
        {values.map((value) => (
          <div class="py-3 border-b border-surface-100 last:border-0">
            <h3 class="font-mono font-semibold text-surface-900">{value.title}</h3>
            <p class="text-sm text-surface-600 mt-1">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Remote -->
  <section class="container-wide section-padding-sm">
    <div class="max-w-3xl">
      <h2 class="text-2xl font-bold text-surface-900 mb-4">No office. On purpose.</h2>
      <p class="text-lg text-surface-600 mb-4">
        Lower overhead means lower rates. Async-first means we document everything
        instead of hoping someone remembers what was said in a meeting. Our clients
        span time zones. We've never missed a deadline because of geography.
      </p>
    </div>
  </section>

  <!-- Open Source -->
  <section class="container-wide section-padding-sm">
    <div class="border-t border-surface-200 pt-8">
      <h2 class="text-lg font-bold text-surface-900 mb-2">Public work</h2>
      <p class="text-surface-600 mb-4">
        Our code is on GitHub. Judge us by what we ship, not what we say.
      </p>
      <a
        href="https://github.com/ntoledo319"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 font-mono text-sm text-surface-700 hover:text-warm-500 transition-colors"
      >
        github.com/ntoledo319 →
      </a>
    </div>
  </section>

  <!-- CTA -->
  <section class="container-wide section-padding-sm">
    <div class="border-t border-surface-200 pt-12 max-w-xl">
      <h2 class="text-2xl font-bold text-surface-900 mb-3">Something broken? Something to build?</h2>
      <p class="text-surface-600 mb-6">
        Tell us what you need. We'll tell you what it takes.
      </p>
      <a href="/contact" class="btn-primary">Get a Quote</a>
    </div>
  </section>
</BaseLayout>
