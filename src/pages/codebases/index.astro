---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { breadcrumbSchema, itemListSchema } from '../../utils/jsonld';

const codebases = await getCollection('codebases');
const sortedCodebases = codebases.sort((a, b) => a.data.order - b.data.order);

const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Codebases', url: '/codebases' }
  ]),
  itemListSchema(
    sortedCodebases.map(c => ({
      name: c.data.title,
      url: `/codebases/${c.slug}`,
      description: c.data.description
    })),
    'Available Codebases'
  )
];

const statusLabels: Record<string, { text: string; class: string }> = {
  'available': { text: 'Available', class: 'bg-green-100 text-green-700' },
  'limited': { text: 'Limited', class: 'bg-yellow-100 text-yellow-700' },
  'in-development': { text: 'In Development', class: 'bg-blue-100 text-blue-700' },
};
---

<BaseLayout
  title="Codebases"
  description="Deploy-ready codebases for security, compliance, and infrastructure. Buy complete, documented repositories with support included."
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="border-b border-surface-200">
    <div class="container-wide section-padding-sm">
      <div class="max-w-3xl">
        <Breadcrumbs items={[
          { label: 'Home', href: '/' },
          { label: 'Codebases' },
        ]} />
        <h1 class="text-4xl sm:text-5xl font-bold text-surface-900 mb-4">
          Codebases for Sale
        </h1>
        <p class="text-xl text-surface-600 mb-6">
          Deploy-ready repositories with documentation, tests, and support. 
          Skip months of development and get something that works today.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="#bundle" class="btn-primary">
            View Bundle Deal
          </a>
          <a href="/contact?subject=Codebase%20Inquiry" class="btn-secondary">
            Request Custom Build
          </a>
          <a href="/blog/buying-a-codebase" class="btn-ghost">
            Read: Buying a Codebase →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Codebase Grid -->
  <section class="container-wide section-padding-sm">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedCodebases.map((codebase) => {
        const status = statusLabels[codebase.data.status] || statusLabels['available'];
        return (
          <a 
            href={`/codebases/${codebase.slug}`}
            class="card-interactive p-6 group flex flex-col"
          >
            <div class="flex items-start justify-between mb-3">
              <span class="text-xs font-medium text-surface-500 uppercase tracking-wide">
                {codebase.data.category}
              </span>
              <span class={`text-xs font-medium px-2 py-1 rounded-full ${status.class}`}>
                {status.text}
              </span>
            </div>
            <h2 class="text-xl font-bold text-surface-900 group-hover:text-warm-500 transition-colors mb-2">
              {codebase.data.title}
            </h2>
            <p class="text-sm text-surface-600 mb-4 flex-grow">
              {codebase.data.tagline}
            </p>
            <div class="flex items-baseline gap-2 mb-2">
              <span class="text-lg font-bold text-surface-900">
                ${codebase.data.price.toLocaleString()}
              </span>
              {codebase.data.originalPrice && (
                <span class="text-sm text-surface-400 line-through">
                  ${codebase.data.originalPrice.toLocaleString()}
                </span>
              )}
            </div>
            {codebase.data.licensesAvailable && codebase.data.licensesAvailable <= 5 && (
              <div class="text-xs text-red-600 font-medium mb-2">
                ⚡ Only {codebase.data.licensesAvailable} left
              </div>
            )}
            <div class="flex flex-wrap gap-2">
              {codebase.data.tags.slice(0, 3).map((tag) => (
                <span class="text-xs px-2 py-1 rounded bg-surface-100 text-surface-600">
                  {tag}
                </span>
              ))}
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- What's Included -->
  <section class="bg-surface-50 border-y border-surface-200">
    <div class="container-wide section-padding">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-2xl font-bold text-surface-900 mb-4">What You Get</h2>
        <p class="text-surface-600 mb-8">
          Every codebase purchase includes everything you need to deploy and maintain.
        </p>
        <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-6 text-left">
          <div class="bg-white rounded-md p-4 border border-surface-200">
            <h3 class="font-semibold text-surface-900 mb-1">Full Source</h3>
            <p class="text-sm text-surface-600">Complete, unobfuscated source code</p>
          </div>
          <div class="bg-white rounded-md p-4 border border-surface-200">
            <h3 class="font-semibold text-surface-900 mb-1">Documentation</h3>
            <p class="text-sm text-surface-600">Setup guides, API docs, architecture overview</p>
          </div>
          <div class="bg-white rounded-md p-4 border border-surface-200">
            <h3 class="font-semibold text-surface-900 mb-1">Test Coverage</h3>
            <p class="text-sm text-surface-600">Automated tests you can run and extend</p>
          </div>
          <div class="bg-white rounded-md p-4 border border-surface-200">
            <h3 class="font-semibold text-surface-900 mb-1">Support Window</h3>
            <p class="text-sm text-surface-600">30–90 days for setup/questions</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bundle Deal -->
  <section id="bundle" class="bg-surface-900 text-white">
    <div class="container-wide section-padding">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl font-bold mb-4">Buy the Bundle — Save $3,500</h2>
        <p class="text-surface-400 text-lg mb-8">
          Get all three codebases for one price. Perfect if you're building a security and automation practice.
        </p>
        <div class="flex items-center justify-center gap-4 mb-8">
          <span class="text-4xl font-bold text-white">$15,000</span>
          <span class="text-xl text-surface-500 line-through">$18,500</span>
          <span class="text-sm bg-green-600 text-white px-3 py-1 rounded-full">Save 19%</span>
        </div>
        <div class="grid sm:grid-cols-3 gap-4 text-left mb-8">
          <div class="bg-surface-800 rounded-md p-4">
            <h3 class="font-semibold mb-1">ComplyCrawl</h3>
            <p class="text-sm text-surface-400">Compliance-first web automation</p>
          </div>
          <div class="bg-surface-800 rounded-md p-4">
            <h3 class="font-semibold mb-1">TallySec</h3>
            <p class="text-sm text-surface-400">Security training platform</p>
          </div>
          <div class="bg-surface-800 rounded-md p-4">
            <h3 class="font-semibold mb-1">AegisTwin</h3>
            <p class="text-sm text-surface-400">Agent runtime + governance</p>
          </div>
        </div>
        <a href="https://buy.stripe.com/28E6oHf2C6ha7Fp6IY87K09" class="btn-primary text-base px-8 py-3" target="_blank" rel="noopener">
          Buy Bundle — $15,000
        </a>
        <p class="text-surface-500 text-sm mt-4">
          Includes all source code, documentation, and 90-day support for all three products.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="container-wide section-padding-sm">
    <div class="border-t border-surface-200 pt-12 max-w-xl">
      <h2 class="text-2xl font-bold text-surface-900 mb-3">Don't see what you need?</h2>
      <p class="text-surface-600 mb-6">
        We can build it from scratch or adapt an existing codebase to your requirements. Custom builds start at $15,000.
      </p>
      <a href="/contact?subject=Custom%20Codebase" class="btn-primary">
        Request Custom Build
      </a>
    </div>
  </section>
</BaseLayout>
