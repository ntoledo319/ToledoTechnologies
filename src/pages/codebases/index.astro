---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { breadcrumbSchema, itemListSchema } from '../../utils/jsonld';

const codebases = await getCollection('codebases');
const sortedCodebases = codebases.sort((a, b) => a.data.order - b.data.order);

const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Codebase Archive', url: '/codebases/' }
  ]),
  itemListSchema(
    sortedCodebases.map((codebase) => ({
      name: codebase.data.title,
      url: `/codebases/${codebase.slug}/`,
      description: codebase.data.description
    })),
    'Toledo Technologies Codebase Archive'
  )
];
---

<BaseLayout
  title="Codebase Archive"
  description="Inspectable engineering references from Toledo Technologies. These repositories document capability and are not offered for sale or license."
  jsonLd={jsonLd}
  realmGlow="0.64 0.17 190"
  realmBg="0.985 0.008 45"
  realmText="0.11 0.03 45"
>
  <section class="border-b border-black/5">
    <div class="container-wide section-padding-sm">
      <div class="max-w-4xl">
        <Breadcrumbs
          items={[{ label: 'Home', href: '/' }, { label: 'Codebase Archive' }]}
        />
        <p
          class="mb-5 font-mono text-xs tracking-[0.28em] uppercase opacity-40"
        >
          Side B · Reference Pressings
        </p>
        <h1 class="mb-5 text-4xl font-bold sm:text-6xl">Codebase Archive</h1>
        <p class="max-w-3xl text-xl leading-relaxed opacity-60">
          Not a storefront. These are retained engineering references: enough
          architecture, artifacts, and limitations to show how Toledo approaches
          a class of problem. No inventory counters, transfer promises, or
          checkout links.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href="/contact?service=custom-software&subject=Comparable%20system%20inquiry"
            class="btn-primary"
          >
            Scope a comparable system
          </a>
          <a href="/portfolio" class="btn-ghost">See the wider proof ledger →</a
          >
        </div>
      </div>
    </div>
  </section>

  <section class="container-wide section-padding-sm">
    <ol class="archive-tracklist" aria-label="Codebase reference notes">
      {
        sortedCodebases.map((codebase, index) => (
          <li>
            <a
              href={`/codebases/${codebase.slug}/`}
              class="archive-track"
              aria-label={`Read the ${codebase.data.title} capability note`}
            >
              <span class="archive-track-number">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="archive-track-copy">
                <span class="archive-track-meta">
                  {codebase.data.category} · reference build
                </span>
                <strong>{codebase.data.title}</strong>
                <span>{codebase.data.tagline}</span>
              </span>
              <span class="archive-track-cue">Read capability note →</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="border-t border-black/5">
    <div class="container-wide section-padding-sm">
      <div class="proof-pressing">
        <div class="proof-pressing-label">
          <span>ARCHIVE NOTE / 001</span>
          <span>NOT FOR SALE</span>
        </div>
        <div class="proof-pressing-body">
          <div>
            <p class="proof-kicker">How to read this shelf</p>
            <h2>Proof is narrower than a promise.</h2>
          </div>
          <ol class="proof-grooves">
            <li>
              <span>01</span>
              <p>
                <strong>Inspect the artifact.</strong> Demos, public source, sample
                output, and repeatable tests count.
              </p>
            </li>
            <li>
              <span>02</span>
              <p>
                <strong>Read the boundary.</strong> A reference build is not a production
                guarantee, certification, or client outcome.
              </p>
            </li>
            <li>
              <span>03</span>
              <p>
                <strong>Scope the new system.</strong> Comparable work receives its
                own discovery, threat model, ownership terms, and acceptance tests.
              </p>
            </li>
          </ol>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
