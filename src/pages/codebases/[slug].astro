---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { breadcrumbSchema, softwareSchema } from '../../utils/jsonld';

export async function getStaticPaths() {
  const codebases = await getCollection('codebases');
  return codebases.map((codebase) => ({
    params: { slug: codebase.slug },
    props: { codebase }
  }));
}

const { codebase } = Astro.props;
const { Content } = await codebase.render();
const contactSubject = encodeURIComponent(
  `Comparable system based on ${codebase.data.title}`
);

const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Codebase Archive', url: '/codebases/' },
    { name: codebase.data.title, url: `/codebases/${codebase.slug}/` }
  ]),
  softwareSchema({
    name: codebase.data.title,
    description: codebase.data.description,
    url: `/codebases/${codebase.slug}/`,
    category: codebase.data.category,
    tags: codebase.data.tags
  })
];
---

<BaseLayout
  title={`${codebase.data.title} — Capability Note`}
  description={codebase.data.description}
  jsonLd={jsonLd}
  realmGlow="0.64 0.17 190"
  realmBg="0.985 0.008 45"
  realmText="0.11 0.03 45"
>
  <section class="border-b border-black/5">
    <div class="container-wide section-padding-sm">
      <div class="max-w-4xl">
        <div
          class="mb-6 flex flex-wrap items-center gap-3 font-mono text-xs tracking-widest uppercase"
        >
          <span class="opacity-40">{codebase.data.category}</span>
          <span aria-hidden="true" class="opacity-20">/</span>
          <span class="text-warm-600">Reference build · not for sale</span>
        </div>
        <Breadcrumbs
          items={[
            { label: 'Home', href: '/' },
            { label: 'Codebase Archive', href: '/codebases/' },
            { label: codebase.data.title }
          ]}
        />
        <h1 class="mb-6 text-4xl font-bold sm:text-6xl">
          {codebase.data.title}
        </h1>
        <p class="mb-5 text-2xl leading-relaxed font-medium opacity-80">
          {codebase.data.tagline}
        </p>
        <p class="max-w-3xl text-xl leading-relaxed opacity-55">
          {codebase.data.description}
        </p>
        <div class="mt-9 flex flex-wrap gap-4">
          <a
            href={`/contact?service=custom-software&subject=${contactSubject}`}
            class="btn-primary"
          >
            Scope a comparable system
          </a>
          <a href="/codebases/" class="btn-ghost">← Back to archive</a>
        </div>
      </div>
    </div>
  </section>

  <section class="container-wide section-padding-sm">
    <div class="grid min-w-0 gap-16 lg:grid-cols-3">
      <div class="min-w-0 lg:col-span-2">
        <div
          class="prose prose-lg prose-headings:tracking-tight prose-a:text-warm-600 max-w-none"
        >
          <Content />
        </div>
      </div>

      <aside class="min-w-0 space-y-10" aria-label="Reference details">
        <div class="proof-stamp">
          <span>ARCHIVE COPY</span>
          <strong>CAPABILITY EVIDENCE</strong>
          <small>No availability or production claim</small>
        </div>

        <div class="border-t border-black/10 pt-8">
          <h2
            class="mb-4 font-mono text-xs tracking-widest uppercase opacity-40"
          >
            Demonstrated primitives
          </h2>
          <ul class="space-y-3">
            {
              codebase.data.features.slice(0, 6).map((feature) => (
                <li class="flex items-start gap-3 text-sm">
                  <span class="text-warm-600 mt-0.5 shrink-0">→</span>
                  <span class="opacity-70">{feature}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="border-t border-black/10 pt-8">
          <h2
            class="mb-4 font-mono text-xs tracking-widest uppercase opacity-40"
          >
            Artifact inventory
          </h2>
          <ul class="space-y-3">
            {
              codebase.data.included.map((item) => (
                <li class="flex items-start gap-3 text-sm">
                  <span class="text-warm-600 shrink-0">→</span>
                  <span class="opacity-70">{item}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="border-t border-black/10 pt-8">
          <h2
            class="mb-4 font-mono text-xs tracking-widest uppercase opacity-40"
          >
            Relevant to
          </h2>
          <ul class="space-y-3">
            {
              codebase.data.targetAudience.map((audience) => (
                <li class="text-sm opacity-65">{audience}</li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="border-t border-black/5">
    <div class="container-wide section-padding-sm">
      <div class="max-w-3xl">
        <p
          class="mb-3 font-mono text-xs tracking-[0.24em] uppercase opacity-40"
        >
          The boundary
        </p>
        <h2 class="mb-4 text-3xl font-bold">
          A reference is a starting point, not a shortcut around discovery.
        </h2>
        <p class="mb-8 text-lg leading-relaxed opacity-60">
          Any new engagement gets its own scope, security review, acceptance
          tests, ownership terms, and deployment plan. Nothing on this archive
          page is a promise that an old repository can be dropped into a new
          operating environment unchanged.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href={`/contact?service=custom-software&subject=${contactSubject}`}
            class="btn-primary"
          >
            Describe the system you need
          </a>
          <a href="/services" class="btn-ghost">See service ranges →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
