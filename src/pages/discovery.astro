---
import InsertLayout from '../layouts/InsertLayout.astro';
---

<InsertLayout
  title="Discovery Products"
  description="Six paid front doors to Toledo Technologies. SiteLift Fit Check, Website Migration Audit, Web App Discovery, AI Automation Blueprint, Mobile App Discovery, and SaaS Strategy."
  heading="Six paid front doors. One of them belongs to you."
  subheading="Every project starts with a paid discovery. It produces a document — risk plan, scope map, fixed-price quote — that you can use whether or not you hire us. Half of every discovery fee credits to your project deposit if you proceed within thirty days."
>
  <p class="eyebrow" style="margin-bottom: 24px;">
    <span class="num">B7</span><span class="bar"></span><span
      >The Discoveries</span
    >
  </p>

  <section id="at-a-glance">
    <h2>The six discoveries at a glance</h2>
    <div style="overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; margin: 24px 0;">
        <thead>
          <tr
            style="border-bottom: 2px solid var(--gf-ink-200); text-align: left;"
          >
            <th style="padding: 12px;">Discovery</th>
            <th style="padding: 12px;">Price</th>
            <th style="padding: 12px;">Time</th>
            <th style="padding: 12px;">Type</th>
          </tr>
        </thead>
        <tbody>
          <tr style="border-bottom: 1px solid var(--gf-ink-100);">
            <td style="padding: 12px;"
              ><a href="#sitelift-fit-check">SiteLift Fit Check</a></td
            >
            <td style="padding: 12px;"><strong>$750</strong></td>
            <td style="padding: 12px;">1–2 days</td>
            <td style="padding: 12px;">Productized, fixed</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--gf-ink-100);">
            <td style="padding: 12px;"
              ><a href="#website-audit">Website Migration Audit</a></td
            >
            <td style="padding: 12px;"><strong>$1,500</strong></td>
            <td style="padding: 12px;">3–5 days</td>
            <td style="padding: 12px;">Productized, fixed</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--gf-ink-100);">
            <td style="padding: 12px;"
              ><a href="#web-app-discovery">Web App Discovery</a></td
            >
            <td style="padding: 12px;">$3,500–$5,000</td>
            <td style="padding: 12px;">1–2 weeks</td>
            <td style="padding: 12px;">Quote-based</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--gf-ink-100);">
            <td style="padding: 12px;"
              ><a href="#ai-blueprint">AI Automation Blueprint</a></td
            >
            <td style="padding: 12px;">$3,500–$10,000</td>
            <td style="padding: 12px;">1–3 weeks</td>
            <td style="padding: 12px;">Quote-based</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--gf-ink-100);">
            <td style="padding: 12px;"
              ><a href="#mobile-discovery">Mobile App Discovery</a></td
            >
            <td style="padding: 12px;">$5,000–$7,500</td>
            <td style="padding: 12px;">1–2 weeks</td>
            <td style="padding: 12px;">Quote-based</td>
          </tr>
          <tr style="border-bottom: 1px solid var(--gf-ink-100);">
            <td style="padding: 12px;"
              ><a href="#saas-strategy">SaaS / Product Strategy</a></td
            >
            <td style="padding: 12px;">$7,500–$15,000</td>
            <td style="padding: 12px;">2–4 weeks</td>
            <td style="padding: 12px;">Quote-based</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p>
      <em
        >The shared rule: Half of every discovery fee credits to the project
        deposit if you proceed within 30 days. You keep the document either way.</em
      >
    </p>
  </section>

  <hr />

  <section id="start" aria-labelledby="start-heading">
    <h2 id="start-heading">Start here</h2>
    <p style="margin-bottom: 24px;">
      Tell us what you're trying to build or fix. We reply in under 24 hours
      with the discovery that fits — and the price. No "let's hop on a call"
      back-and-forth.
    </p>

    <form
      action="https://formsubmit.co/hello@toledotechnologies.com"
      method="POST"
      style="border: 1px solid var(--gf-ink-200); padding: 32px; background: var(--gf-ink-50);"
    >
      <input type="hidden" name="_subject" value="New discovery inquiry" />
      <input type="hidden" name="_captcha" value="false" />
      <input type="hidden" name="_template" value="table" />
      <input
        type="hidden"
        name="_next"
        value="https://toledotechnologies.com/discovery?submitted=true"
      />
      <input type="text" name="_honey" style="display:none" tabindex="-1" />

      <fieldset style="border: none; padding: 0; margin: 0 0 24px;">
        <legend
          style="font-family: var(--gf-font-mono); font-size: 13px; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px;"
        >
          What are you trying to build or fix? *
        </legend>
        <div style="display: grid; gap: 8px;">
          <label style="display: flex; gap: 12px; cursor: pointer;">
            <input type="radio" name="intent" value="website" required />
            <span>A new website (or rebuild of an existing one)</span>
          </label>
          <label style="display: flex; gap: 12px; cursor: pointer;">
            <input type="radio" name="intent" value="wordpress-exit" />
            <span>I want off WordPress</span>
          </label>
          <label style="display: flex; gap: 12px; cursor: pointer;">
            <input type="radio" name="intent" value="internal-tool" />
            <span>An internal tool, portal, or custom software</span>
          </label>
          <label style="display: flex; gap: 12px; cursor: pointer;">
            <input type="radio" name="intent" value="mobile" />
            <span>A mobile app (or rescue of one in progress)</span>
          </label>
          <label style="display: flex; gap: 12px; cursor: pointer;">
            <input type="radio" name="intent" value="ai" />
            <span>An AI workflow or agent, with governance</span>
          </label>
          <label style="display: flex; gap: 12px; cursor: pointer;">
            <input type="radio" name="intent" value="unsure" />
            <span>I'm not sure yet</span>
          </label>
        </div>
      </fieldset>

      <fieldset style="border: none; padding: 0; margin: 0 0 24px;">
        <legend
          style="font-family: var(--gf-font-mono); font-size: 13px; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px;"
        >
          Rough budget band
        </legend>
        <div style="display: grid; gap: 8px;">
          <label style="display: flex; gap: 12px; cursor: pointer;">
            <input type="radio" name="budget" value="under-5k" />
            <span>Under $5K</span>
          </label>
          <label style="display: flex; gap: 12px; cursor: pointer;">
            <input type="radio" name="budget" value="5k-15k" />
            <span>$5K–$15K</span>
          </label>
          <label style="display: flex; gap: 12px; cursor: pointer;">
            <input type="radio" name="budget" value="15k-50k" />
            <span>$15K–$50K</span>
          </label>
          <label style="display: flex; gap: 12px; cursor: pointer;">
            <input type="radio" name="budget" value="50k-plus" />
            <span>$50K+</span>
          </label>
          <label style="display: flex; gap: 12px; cursor: pointer;">
            <input type="radio" name="budget" value="unsure" />
            <span>Not sure yet</span>
          </label>
        </div>
      </fieldset>

      <div style="margin-bottom: 24px;">
        <label
          for="trigger"
          style="display: block; font-family: var(--gf-font-mono); font-size: 13px; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;"
        >
          What's the trigger?
        </label>
        <textarea
          id="trigger"
          name="trigger"
          rows="3"
          placeholder="Got hacked. Site is slow. Lost a deal to a competitor with a portal. Just raised. Plugin broke."
          style="width: 100%; padding: 12px; border: 1px solid var(--gf-ink-200); background: white; font-family: inherit; font-size: 15px; resize: vertical;"
        ></textarea>
      </div>

      <div style="display: grid; gap: 16px; grid-template-columns: 1fr 1fr; margin-bottom: 24px;">
        <div>
          <label
            for="name"
            style="display: block; font-family: var(--gf-font-mono); font-size: 13px; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;"
          >
            Name *
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            style="width: 100%; padding: 12px; border: 1px solid var(--gf-ink-200); background: white; font-family: inherit; font-size: 15px;"
          />
        </div>
        <div>
          <label
            for="email"
            style="display: block; font-family: var(--gf-font-mono); font-size: 13px; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;"
          >
            Email *
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            style="width: 100%; padding: 12px; border: 1px solid var(--gf-ink-200); background: white; font-family: inherit; font-size: 15px;"
          />
        </div>
      </div>

      <div style="margin-bottom: 24px;">
        <label
          for="site-url"
          style="display: block; font-family: var(--gf-font-mono); font-size: 13px; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;"
        >
          Site URL (if relevant)
        </label>
        <input
          type="url"
          id="site-url"
          name="site_url"
          placeholder="https://"
          style="width: 100%; padding: 12px; border: 1px solid var(--gf-ink-200); background: white; font-family: inherit; font-size: 15px;"
        />
      </div>

      <button
        type="submit"
        style="background: var(--gf-ink-900); color: var(--gf-paper); border: none; padding: 14px 28px; font-family: var(--gf-font-mono); font-size: 14px; text-transform: uppercase; letter-spacing: 0.08em; cursor: pointer;"
      >
        Send inquiry →
      </button>

      <p
        style="margin-top: 16px; font-size: 13px; color: var(--gf-ink-700); font-style: italic;"
      >
        We reply by email. We don't book sales calls before we know what
        you need.
      </p>
    </form>

    {Astro.url.searchParams.get('submitted') === 'true' && (
      <div
        style="margin-top: 32px; padding: 24px; border: 1px solid var(--gf-ink-900); background: var(--gf-paper);"
      >
        <p style="margin: 0;">
          <strong>Inquiry received.</strong> We reply within 24 hours from{' '}
          <code>hello@toledotechnologies.com</code>. If you don't see a reply,
          check spam — and reply to that thread so we can fix it.
        </p>
      </div>
    )}
  </section>

  <hr />

  <section>
    <h2>If you'd rather self-route</h2>
    <p>
      The same routing, but as a static reference. Useful if you already know
      what you want and just need the link.
    </p>
    <div
      style="font-family: var(--gf-font-mono); font-size: 14px; background: var(--gf-ink-50); padding: 24px; border: 1px solid var(--gf-ink-100);"
    >
      <div
        style="display: grid; grid-template-columns: 1fr auto; gap: 16px; border-bottom: 1px solid var(--gf-ink-200); padding-bottom: 8px; margin-bottom: 8px; font-weight: bold;"
      >
        <span>What you came to do</span>
        <span>Which discovery</span>
      </div>
      <div
        style="display: grid; grid-template-columns: 1fr auto; gap: 16px; margin-bottom: 4px;"
      >
        <span>"My WordPress costs too much"</span>
        <span
          >→ <a href="#sitelift-fit-check">SiteLift Fit Check ($750)</a></span
        >
      </div>
      <div
        style="display: grid; grid-template-columns: 1fr auto; gap: 16px; margin-bottom: 4px;"
      >
        <span>"Custom website rebuild, escaping WordPress"</span>
        <span
          >→ <a href="#website-audit">Website Migration Audit ($1,500)</a></span
        >
      </div>
      <div
        style="display: grid; grid-template-columns: 1fr auto; gap: 16px; margin-bottom: 4px;"
      >
        <span>"Custom-designed site, no migration needed"</span>
        <span
          >→ Package inquiry on <a href="https://web.toledotechnologies.com"
            >ToledoWeb</a
          ></span
        >
      </div>
      <div
        style="display: grid; grid-template-columns: 1fr auto; gap: 16px; margin-bottom: 4px;"
      >
        <span>"Internal tool to replace spreadsheets"</span>
        <span
          >→ <a href="#web-app-discovery">Web App Discovery ($3,500–$5,000)</a
          ></span
        >
      </div>
      <div
        style="display: grid; grid-template-columns: 1fr auto; gap: 16px; margin-bottom: 4px;"
      >
        <span>"SaaS MVP — build the product"</span>
        <span
          >→ <a href="#saas-strategy">SaaS / Strategy ($7,500–$15,000)</a></span
        >
      </div>
      <div
        style="display: grid; grid-template-columns: 1fr auto; gap: 16px; margin-bottom: 4px;"
      >
        <span>"AI workflow, agent, or RAG system"</span>
        <span>→ <a href="#ai-blueprint">AI Blueprint ($3,500–$10,000)</a></span>
      </div>
      <div
        style="display: grid; grid-template-columns: 1fr auto; gap: 16px; margin-bottom: 4px;"
      >
        <span>"Mobile app — iOS, Android, cross-platform"</span>
        <span
          >→ <a href="#mobile-discovery">Mobile Discovery ($5,000–$7,500)</a
          ></span
        >
      </div>
    </div>
    <p style="margin-top: 16px;">
      <a href="/contact">→ Genuinely don't know? Write a letter.</a>
    </p>
  </section>

  <hr />

  <section>
    <div
      id="sitelift-fit-check"
      style="margin-bottom: 48px; scroll-margin-top: 100px;"
    >
      <h3>SiteLift Fit Check ($750 fixed)</h3>
      <p>
        The smallest paid front door. Productized triage for productized
        WordPress exits. We confirm which of the four SiteLift packages fits,
        which destination platform makes sense, and any data risks before
        quoting the full project. One to two business days.
      </p>
      <ul>
        <li>
          <strong>For:</strong> Small businesses on WordPress, Squarespace, or Wix
        </li>
        <li>
          <strong>Inquiry:</strong>
          <a href="https://sitelift.toledotechnologies.com/fit-check"
            >sitelift.toledotechnologies.com/fit-check →</a
          >
        </li>
      </ul>
    </div>

    <div
      id="website-audit"
      style="margin-bottom: 48px; scroll-margin-top: 100px;"
    >
      <h3>Website Migration Audit ($1,500 fixed)</h3>
      <p>
        The deeper migration discovery. For 25+ page sites with real SEO equity,
        custom design ambition, or compliance needs. Three to five business
        days.
      </p>
      <ul>
        <li>
          <strong>For:</strong> Established sites where the rebuild quote depends
          on what we find inside
        </li>
        <li>
          <strong>Inquiry:</strong>
          <a href="https://web.toledotechnologies.com/audit"
            >web.toledotechnologies.com/audit →</a
          >
        </li>
      </ul>
    </div>

    <div
      id="web-app-discovery"
      style="margin-bottom: 48px; scroll-margin-top: 100px;"
    >
      <h3>Web App Discovery ($3,500 – $5,000)</h3>
      <p>
        Required first step for any internal tool, customer portal, dashboard,
        or custom web app. Maps the feature set, the database schema, the
        integrations, and the user roles. One to two weeks.
      </p>
      <ul>
        <li><strong>For:</strong> Operations leaders, ops-heavy businesses</li>
        <li>
          <strong>Inquiry:</strong>
          <a href="https://apps.toledotechnologies.com/discovery"
            >apps.toledotechnologies.com/discovery →</a
          >
        </li>
      </ul>
    </div>

    <div
      id="ai-blueprint"
      style="margin-bottom: 48px; scroll-margin-top: 100px;"
    >
      <h3>AI Automation Blueprint ($3,500 – $10,000)</h3>
      <p>
        Required first step for any production AI engagement. Maps the data
        sources, the autonomy level, the governance posture, the integration
        surface. One to three weeks.
      </p>
      <ul>
        <li>
          <strong>For:</strong> Anyone building AI that touches business data or autonomous
          action
        </li>
        <li>
          <strong>Inquiry:</strong>
          <a href="https://ai.toledotechnologies.com/discovery"
            >ai.toledotechnologies.com/discovery →</a
          >
        </li>
      </ul>
    </div>

    <div
      id="mobile-discovery"
      style="margin-bottom: 48px; scroll-margin-top: 100px;"
    >
      <h3>Mobile App Discovery ($5,000 – $7,500)</h3>
      <p>
        Required first step for any iOS, Android, or cross-platform engagement.
        Maps the screen set, the hardware features, the App Store risks, and the
        launch plan. One to two weeks.
      </p>
      <ul>
        <li><strong>For:</strong> Product owners, consumer brands</li>
        <li>
          <strong>Inquiry:</strong>
          <a href="https://mobile.toledotechnologies.com/discovery"
            >mobile.toledotechnologies.com/discovery →</a
          >
        </li>
      </ul>
    </div>

    <div
      id="saas-strategy"
      style="margin-bottom: 48px; scroll-margin-top: 100px;"
    >
      <h3>SaaS / Product Strategy ($7,500 – $15,000)</h3>
      <p>
        The deeper Apps-track discovery for SaaS founders. Product strategy,
        business model validation, technical architecture, and financial model.
        Two to four weeks.
      </p>
      <ul>
        <li>
          <strong>For:</strong> SaaS founders at idea, post-validation, or repositioning
        </li>
        <li>
          <strong>Inquiry:</strong>
          <a href="https://apps.toledotechnologies.com/discovery"
            >apps.toledotechnologies.com/discovery (SaaS track) →</a
          >
        </li>
      </ul>
    </div>
  </section>

  <hr />

  <section>
    <h2>Why every project starts here</h2>
    <p>
      A free consultation is paid for in someone else's time, and that someone
      is usually the person doing the work. We don't run free consultations
      because the people who would do the discovery work aren't in a position to
      give it away. So we charge for it. The trade is that the discovery
      produces something real — a document you can take to any developer.
    </p>
    <p>
      Every quote that doesn't go through discovery is a guess. Discovery is how
      we both end up at the right number.
    </p>
  </section>

  <hr />

  <section id="not-sure">
    <h2>Not sure which one belongs to you?</h2>
    <form
      action="https://formsubmit.co/hello@toledotechnologies.com"
      method="POST"
      class="intake-form"
      style="display: grid; gap: 24px; max-width: 600px;"
    >
      <input
        type="hidden"
        name="_subject"
        value="New Discovery Routing Inquiry"
      />
      <input type="hidden" name="_honey" style="display:none" />

      <fieldset
        style="border: 1px solid var(--gf-ink-200); padding: 24px; display: grid; gap: 16px;"
      >
        <legend style="padding: 0 8px; font-weight: bold;">Route me</legend>

        <label style="display: grid; gap: 8px;">
          In your own words, what are you trying to accomplish? *
          <textarea
            name="goal"
            rows="5"
            required
            placeholder="Two or three sentences. We'll route you to the right discovery."
            style="padding: 8px; border: 1px solid var(--gf-ink-300);"
          ></textarea>
        </label>

        <label style="display: grid; gap: 8px;">
          Best guess at budget range *
          <select
            name="budget"
            required
            style="padding: 8px; border: 1px solid var(--gf-ink-300);"
          >
            <option value="">Select…</option>
            <option value="<5k">Under $5K</option>
            <option value="5-25k">$5K–$25K</option>
            <option value="25-100k">$25K–$100K</option>
            <option value="100-500k">$100K–$500K</option>
            <option value="500k+">$500K+</option>
            <option value="not-sure">Not sure</option>
          </select>
        </label>

        <label style="display: grid; gap: 8px;">
          Timeline *
          <select
            name="timeline"
            required
            style="padding: 8px; border: 1px solid var(--gf-ink-300);"
          >
            <option value="">Select…</option>
            <option value="urgent">ASAP</option>
            <option value="next-month">Within a month</option>
            <option value="next-quarter">Within a quarter</option>
            <option value="exploring">Exploring</option>
          </select>
        </label>
      </fieldset>

      <fieldset
        style="border: 1px solid var(--gf-ink-200); padding: 24px; display: grid; gap: 16px;"
      >
        <legend style="padding: 0 8px; font-weight: bold;">Contact</legend>
        <label style="display: grid; gap: 8px;"
          >Name * <input
            type="text"
            name="name"
            required
            style="padding: 8px; border: 1px solid var(--gf-ink-300);"
          /></label
        >
        <label style="display: grid; gap: 8px;"
          >Email * <input
            type="email"
            name="email"
            required
            style="padding: 8px; border: 1px solid var(--gf-ink-300);"
          /></label
        >
        <label style="display: grid; gap: 8px;"
          >Company <input
            type="text"
            name="company"
            style="padding: 8px; border: 1px solid var(--gf-ink-300);"
          /></label
        >
      </fieldset>

      <button
        type="submit"
        style="padding: 16px; background: var(--gf-ink-900); color: white; border: none; cursor: pointer; font-weight: bold;"
        >Submit — we'll route you within 1 business day</button
      >
    </form>
  </section>

  <hr />

  <section
    class="cta-banner"
    style="background: var(--gf-ink-900); color: white; padding: 48px; text-align: center;"
  >
    <p
      class="meta"
      style="text-transform: uppercase; letter-spacing: 0.1em; font-size: 12px; margin-bottom: 16px;"
    >
      B7 / Outro
    </p>
    <h2 style="font-size: 32px; margin-bottom: 16px;">
      The hard part is picking which front door. The discovery itself does the
      rest.
    </h2>
    <div style="display: flex; gap: 16px; justify-content: center;">
      <a
        href="#at-a-glance"
        style="display: inline-block; padding: 12px 24px; border: 1px solid white; color: white; text-decoration: none; font-weight: bold;"
        >Pick a discovery</a
      >
      <a
        href="/contact"
        style="display: inline-block; padding: 12px 24px; border: 1px solid rgba(255,255,255,0.3); color: white; text-decoration: none; font-weight: bold;"
        >Talk it through</a
      >
    </div>
  </section>
</InsertLayout>
