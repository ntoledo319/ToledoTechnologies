---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { breadcrumbSchema } from '../utils/jsonld';

const jsonLd = breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Contact', url: '/contact' }
]);

const topics = [
  { value: '', label: 'Choose the closest track...' },
  { value: 'website', label: 'Custom Website' },
  { value: 'wordpress-exit', label: 'WordPress Exit' },
  { value: 'custom-software', label: 'Web App or Custom Software' },
  { value: 'mobile', label: 'Mobile App' },
  { value: 'ai-automation', label: 'AI or Automation' },
  { value: 'bug-fix', label: 'Fix Something Broken' },
  { value: 'nonprofit', label: 'Nonprofit Project' },
  { value: 'partner', label: 'Agency Partnership' },
  { value: 'care', label: 'Care Plan' },
  { value: 'other', label: 'Not Sure Yet' }
];

const budgets = [
  { value: '', label: 'Rough budget range...' },
  { value: 'under-5k', label: 'Under $5,000' },
  { value: '5k-15k', label: '$5,000 - $15,000' },
  { value: '15k-50k', label: '$15,000 - $50,000' },
  { value: 'over-50k', label: 'Over $50,000' },
  { value: 'not-sure', label: 'Not sure yet' }
];

const whatToInclude = [
  'What you need built or fixed',
  'Current tech stack (if applicable)',
  'Timeline constraints',
  'Budget range (helps us scope properly)',
  'Any relevant links or documentation'
];
---

<BaseLayout
  title="Contact"
  description="Describe a software project, repair, or discovery need. Toledo Technologies reviews the context and replies by email with questions or a concrete routing plan."
  jsonLd={jsonLd}
  realmGlow="0.60 0.18 340"
  realmBg="0.10 0.02 280"
  realmText="0.98 0.02 280"
>
  <!-- Hero -->
  <section class="border-b border-black/5">
    <div class="container-wide section-padding-sm relative z-10">
      <div class="max-w-4xl">
        <Breadcrumbs
          items={[{ label: 'Home', href: '/' }, { label: 'Contact' }]}
        />
        <h1
          class="mb-6 text-5xl leading-[0.9] font-bold tracking-tight sm:text-7xl"
        >
          Write <span class="text-brand-400 italic">Nicholas</span>
        </h1>
        <p class="max-w-2xl text-xl leading-relaxed opacity-50 sm:text-2xl">
          Toledo Technologies is founder-led. Tell Nicholas what you need; the
          reply will ask the useful questions or give you a concrete routing
          plan.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Content -->
  <section class="container-wide section-padding-sm">
    <div class="grid gap-16 lg:grid-cols-3">
      <!-- Form Column -->
      <div class="lg:col-span-2">
        <form
          id="project-inquiry"
          action="https://eolkits.com/api/v1/lead"
          method="POST"
          class="space-y-8"
        >
          <input
            type="hidden"
            name="_subject"
            id="lead-subject"
            value="New Contact Form Submission"
          />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_template" value="table" />
          <input
            type="hidden"
            name="source"
            value="toledotechnologies.com/contact"
          />
          <input
            type="hidden"
            name="product"
            value="Toledo Technologies services"
          />
          <input
            type="hidden"
            name="service"
            id="lead-service"
            value="general"
          />
          <input
            type="hidden"
            name="context"
            id="lead-context"
            value="Direct contact inquiry"
          />
          <input type="text" name="_honey" style="display:none" />
          <input
            type="hidden"
            name="_next"
            value="https://toledotechnologies.com/contact?submitted=true"
          />

          <p
            id="inquiry-context"
            class="hidden border-l-2 border-current pl-4 font-mono text-xs tracking-wide uppercase opacity-55"
            role="status"
          >
          </p>

          <div class="grid gap-8 sm:grid-cols-2">
            <div>
              <label
                for="name"
                class="mb-3 block text-sm font-medium opacity-60"
              >
                Name
              </label>
              <input
                type="text"
                id="name"
                name="name"
                class="rounded-engine-pill focus:border-warm-500 focus:ring-warm-500 text-surface-900 w-full border border-black/10 bg-black/5 px-6 py-4 transition-all placeholder:text-black/30 focus:ring-1"
                placeholder="Your name"
              />
            </div>
            <div>
              <label
                for="email"
                class="mb-3 block text-sm font-medium opacity-60"
              >
                Email *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="rounded-engine-pill focus:border-warm-500 focus:ring-warm-500 text-surface-900 w-full border border-black/10 bg-black/5 px-6 py-4 transition-all placeholder:text-black/30 focus:ring-1"
                placeholder="you@example.com"
              />
            </div>
          </div>

          <div>
            <label
              for="topic"
              class="mb-3 block text-sm font-medium opacity-60"
            >
              What do you need help with?
            </label>
            <select
              id="topic"
              name="topic"
              class="rounded-engine-pill focus:border-warm-500 focus:ring-warm-500 text-surface-900 w-full border border-black/10 bg-black/5 px-6 py-4 transition-all focus:ring-1"
            >
              {
                topics.map((topic) => (
                  <option value={topic.value}>{topic.label}</option>
                ))
              }
            </select>
          </div>

          <div>
            <label
              for="budget"
              class="mb-3 block text-sm font-medium opacity-60"
            >
              Budget Range
            </label>
            <select
              id="budget"
              name="budget"
              class="rounded-engine-pill focus:border-warm-500 focus:ring-warm-500 text-surface-900 w-full border border-black/10 bg-black/5 px-6 py-4 transition-all focus:ring-1"
            >
              {
                budgets.map((budget) => (
                  <option value={budget.value}>{budget.label}</option>
                ))
              }
            </select>
          </div>

          <div>
            <label
              for="message"
              class="mb-3 block text-sm font-medium opacity-60"
            >
              Tell us more
            </label>
            <textarea
              id="message"
              name="message"
              rows="6"
              class="rounded-engine-inner focus:border-warm-500 focus:ring-warm-500 text-surface-900 w-full resize-y border border-black/10 bg-black/5 px-6 py-4 transition-all placeholder:text-black/30 focus:ring-1"
              placeholder="Describe your project, problem, or question..."
            ></textarea>
          </div>

          <div>
            <button
              type="submit"
              class="btn-primary w-full px-10 py-4 text-base sm:w-auto"
            >
              Send Message
            </button>
          </div>

          <p class="text-sm leading-relaxed opacity-45">
            This form posts to Toledo's lead intake service at eolkits.com. The
            submission is stored in the operating lead database and sends an
            owner notification email. Read the <a href="/privacy"
              >privacy details</a
            >, or skip the form and email
            <a
              href="mailto:hello@toledotechnologies.com"
              class="text-warm-400 hover:underline"
            >
              hello@toledotechnologies.com
            </a>
          </p>

          <div
            id="submission-success"
            class="hidden border border-black/15 p-5 text-sm"
            role="status"
          >
            <strong>Message received.</strong> Any reply will come from hello@toledotechnologies.com.
          </div>
        </form>
      </div>

      <!-- Sidebar -->
      <aside class="space-y-12" aria-label="Contact information">
        <div>
          <h2 class="mb-4 text-xl font-bold">Prefer Email Directly?</h2>
          <p class="mb-4 text-sm opacity-50">
            Skip the form and email us directly. Same response time.
          </p>
          <div class="mb-6">
            <p
              class="mb-1 text-xs font-bold tracking-widest uppercase opacity-30"
            >
              Support Hours
            </p>
            <p class="text-sm opacity-60">Mon–Fri, 10:00 AM–5:30 PM ET</p>
            <p class="mt-1 text-xs opacity-55">
              Replies are sent during support hours.
            </p>
          </div>
          <a
            href="mailto:hello@toledotechnologies.com"
            class="hover:text-warm-400 inline-flex items-center gap-2 text-sm transition-colors"
          >
            <svg
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            hello@toledotechnologies.com
          </a>
        </div>

        <div class="border-t border-black/5 pt-12">
          <h2 class="mb-4 text-xl font-bold">What to Include</h2>
          <p class="mb-4 text-sm opacity-50">
            The more context you provide upfront, the faster we can give you a
            useful response:
          </p>
          <ul class="space-y-3">
            {
              whatToInclude.map((item) => (
                <li class="flex items-start gap-3 text-sm">
                  <span class="text-brand-400 mt-0.5 shrink-0">→</span>
                  <span class="opacity-60">{item}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="border-t border-black/5 pt-12">
          <h2 class="mb-3 text-xl font-bold">Check Our Work</h2>
          <p class="mb-4 text-sm opacity-40">
            See our public projects and contributions on GitHub.
          </p>
          <a
            href="https://github.com/ntoledo319"
            target="_blank"
            rel="noopener noreferrer"
            class="text-brand-400 hover:text-brand-300 inline-flex items-center gap-2 text-sm font-medium transition-colors"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path
                fill-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                clip-rule="evenodd"></path>
            </svg>
            View GitHub Profile
          </a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  function applyInquiryContext() {
    const urlParams = new URLSearchParams(window.location.search);
    const service = urlParams.get('service') || 'general';
    const subject = urlParams.get('subject')?.trim() || '';
    const context = subject || (service !== 'general' ? service : '');
    const serviceInput =
      document.querySelector<HTMLInputElement>('#lead-service');
    const contextInput =
      document.querySelector<HTMLInputElement>('#lead-context');
    const subjectInput =
      document.querySelector<HTMLInputElement>('#lead-subject');
    const topicSelect = document.querySelector<HTMLSelectElement>('#topic');
    const contextNote = document.querySelector<HTMLElement>('#inquiry-context');

    if (serviceInput) serviceInput.value = service;
    if (contextInput) contextInput.value = context || 'Direct contact inquiry';
    if (subjectInput && context) subjectInput.value = `New inquiry: ${context}`;

    if (topicSelect) {
      const available = Array.from(topicSelect.options).some(
        (option) => option.value === service
      );
      if (available) topicSelect.value = service;
    }

    if (contextNote && context) {
      contextNote.textContent = `Inquiry context carried forward: ${context}`;
      contextNote.classList.remove('hidden');
    }

    if (urlParams.get('submitted') === 'true') {
      document.querySelector('#submission-success')?.classList.remove('hidden');
    }
  }

  applyInquiryContext();
  document.addEventListener('astro:page-load', applyInquiryContext);
</script>
