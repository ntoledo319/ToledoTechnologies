---
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbSchema } from '../utils/jsonld';

const jsonLd = breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Nonprofit', url: '/nonprofit' }
]);

const values = [
  {
    title: 'People > Product',
    description: 'Users are humans, not "MAUs" to optimize. We build for people, not metrics.'
  },
  {
    title: 'Open > Opaque',
    description: 'Code, decisions, and failures should be explainable. Transparency by default.'
  },
  {
    title: 'Non-Extractive',
    description: 'No dark patterns, no casino UX, no secret data resale. Ever.'
  },
  {
    title: 'Safety First',
    description: 'Especially around mental health, crisis content, and vulnerable users.'
  },
  {
    title: 'Environmentally Conscious',
    description: 'Model choice, caching, and infra design factor in energy cost, not just latency.'
  },
  {
    title: 'Free or Radically Affordable',
    description: 'The basics of being human shouldn\'t be paywalled.'
  }
];

const flagshipProjects = [
  {
    name: 'NOUS',
    tagline: '"Not Your Therapist" — But Actually Helpful',
    description: 'A mental-health-aware AI companion and next-gen personal assistant. NOUS helps users practice real therapeutic tools (CBT, DBT), track patterns over time, and build coping plans—all with clear limits and safety rails.',
    features: [
      'Real skills engine, not just "positive vibes"',
      'Pattern tracking and plain-language reflection',
      'Calendar, tasks, and habit integration',
      'Hard edges around what it won\'t do',
      'Crisis escalation to human professionals'
    ],
    notFeatures: [
      'Not a licensed clinician',
      'Not a crisis service',
      'Not a replacement for real therapy'
    ],
    status: 'Early pre-beta'
  },
  {
    name: 'ENODIOS',
    tagline: 'The Everything Agent for People Who Can\'t Afford $20/Tool',
    description: 'AI is becoming "paywall your way to power or get left behind." ENODIOS takes free and low-cost models, orchestrates them smartly, and squeezes every ounce of value so normal people can build anything.',
    features: [
      'Code generation and refactoring',
      'Content, copy, and research',
      'Creative work: ideas, outlines, drafts',
      'Multi-model, open-first stack',
      'Reusable templates and pipelines'
    ],
    notFeatures: [],
    status: 'Pre-beta, expanding from coding to general creation'
  }
];
---

<BaseLayout
  title="Daedalus Landed"
  description="A nonprofit initiative building free, humane AI systems for mental health, creation, and education. Taking the profit motive out of the basics of being human."
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-warm-50 via-white to-surface-50">
    <div class="container-wide section-padding">
      <div class="max-w-3xl">
        <span class="inline-block px-3 py-1 rounded-full bg-warm-100 text-warm-700 text-sm font-medium mb-4">
          Nonprofit Initiative
        </span>
        <h1 class="text-4xl sm:text-5xl font-bold text-surface-900 mb-6">
          Daedalus Landed
        </h1>
        <p class="text-xl text-surface-600 mb-4">
          <strong>A nonprofit initiative we're building.</strong>
        </p>
        <p class="text-xl text-surface-600 mb-8">
          We're building free (or radically affordable) AI systems that <em>actually</em> help people 
          and don't treat them as ad inventory, data exhaust, or whales to be monetized.
        </p>
        <p class="text-lg text-surface-700 mb-8 font-medium">
          Mission: Take the profit motive out of the basics of being human—starting with 
          <span class="text-warm-600">mental health</span>, 
          <span class="text-warm-600">creation</span>, and 
          <span class="text-warm-600">education</span>.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="https://github.com/Daedalus-Landed" target="_blank" rel="noopener noreferrer" class="btn-primary">
            View on GitHub →
          </a>
          <a href="/contact?subject=Daedalus%20Landed" class="btn-secondary">
            Get Involved
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- The Problem -->
  <section class="container-wide section-padding-sm">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold text-surface-900 mb-6">Why This Exists</h2>
      <div class="bg-surface-50 rounded-md p-8 border border-surface-200">
        <p class="text-surface-700 mb-4">
          Right now, to get serious AI for your life or work, you mostly have to:
        </p>
        <ul class="space-y-3 mb-6">
          <li class="flex items-start gap-3">
            <span class="text-red-500 mt-1">✗</span>
            <span class="text-surface-600">Pay for premium models every month</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-red-500 mt-1">✗</span>
            <span class="text-surface-600">Hand over your data, behavior, and attention</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-red-500 mt-1">✗</span>
            <span class="text-surface-600">Or settle for weak "free" tools that quietly exploit you</span>
          </li>
        </ul>
        <div class="bg-white rounded-md p-6 border-l-4 border-warm-500">
          <p class="text-surface-800 font-medium">
            Daedalus Landed is trying a different path: Build strong, humane AI systems under a 
            nonprofit umbrella, keep the core tools free or radically cheap, and refuse to fund 
            it by selling users out.
          </p>
        </div>
        <p class="text-surface-500 mt-4 text-sm italic">
          Early-stage and evolving. The mission is stable.
        </p>
      </div>
    </div>
  </section>

  <!-- Flagship Projects -->
  <section class="bg-surface-50 border-y border-surface-200">
    <div class="container-wide section-padding">
      <h2 class="text-2xl font-bold text-surface-900 mb-8">Flagship Projects</h2>
      <div class="grid lg:grid-cols-2 gap-8">
        {flagshipProjects.map((project) => (
          <div class="bg-white rounded-md p-8 border border-surface-200">
            <div class="mb-4">
              <h3 class="text-xl font-bold font-mono text-surface-900">{project.name}</h3>
              <p class="text-sm text-surface-500 mt-1">{project.tagline}</p>
            </div>
            <p class="text-surface-600 mb-4">{project.description}</p>
            
            <h4 class="font-semibold text-surface-800 mb-2 text-sm">What It Does</h4>
            <ul class="space-y-1 mb-4">
              {project.features.map((feature) => (
                <li class="flex items-start gap-2 text-sm text-surface-600">
                  <span class="text-green-500 mt-0.5">✓</span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
            
            {project.notFeatures.length > 0 && (
              <>
                <h4 class="font-semibold text-surface-800 mb-2 text-sm">What It's Not</h4>
                <ul class="space-y-1 mb-4">
                  {project.notFeatures.map((notFeature) => (
                    <li class="flex items-start gap-2 text-sm text-surface-500">
                      <span class="text-red-400 mt-0.5">✗</span>
                      <span>{notFeature}</span>
                    </li>
                  ))}
                </ul>
              </>
            )}
            
            <span class="inline-block px-3 py-1 rounded-full bg-surface-100 text-surface-600 text-xs font-medium">
              {project.status}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="container-wide section-padding-sm">
    <h2 class="text-2xl font-bold text-surface-900 mb-6">Values & Ethics</h2>
    <div class="grid md:grid-cols-2 gap-x-12 gap-y-4 max-w-4xl">
      {values.map((value) => (
        <div class="py-3 border-b border-surface-100 last:border-0">
          <h3 class="font-mono font-semibold text-surface-900">{value.title}</h3>
          <p class="text-sm text-surface-600 mt-1">{value.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- How to Support -->
  <section class="bg-warm-50 border-y border-warm-200">
    <div class="container-wide section-padding">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-bold text-surface-900 mb-4">How to support</h2>
        <p class="text-surface-600 mb-8">
          We're keeping these systems free from ad-tech and predatory monetization.
          That means we need help with the unsexy parts: infra, hosting, audits, and eventually clinical research.
        </p>
        <div class="grid sm:grid-cols-2 gap-3 mb-8 max-w-2xl mx-auto text-left">
          <div class="flex items-start gap-3 py-3">
            <span class="text-warm-600 font-mono font-bold shrink-0">01</span>
            <div>
              <h3 class="font-mono font-semibold text-surface-900 text-sm">Star the repos</h3>
              <p class="text-xs text-surface-500">Visibility matters more than you think</p>
            </div>
          </div>
          <div class="flex items-start gap-3 py-3">
            <span class="text-warm-600 font-mono font-bold shrink-0">02</span>
            <div>
              <h3 class="font-mono font-semibold text-surface-900 text-sm">Open issues</h3>
              <p class="text-xs text-surface-500">Bug reports, safety concerns, edge cases</p>
            </div>
          </div>
          <div class="flex items-start gap-3 py-3">
            <span class="text-warm-600 font-mono font-bold shrink-0">03</span>
            <div>
              <h3 class="font-mono font-semibold text-surface-900 text-sm">Help test</h3>
              <p class="text-xs text-surface-500">Dogfood early builds, tell us what breaks</p>
            </div>
          </div>
          <div class="flex items-start gap-3 py-3">
            <span class="text-warm-600 font-mono font-bold shrink-0">04</span>
            <div>
              <h3 class="font-mono font-semibold text-surface-900 text-sm">Fund the work</h3>
              <p class="text-xs text-surface-500">Keeps lights on, servers up</p>
            </div>
          </div>
        </div>
        <p class="text-sm text-surface-500 italic">
          No donation buys you surveillance rights. No donation buys you a data firehose. 
          It just keeps the lights on.
        </p>
      </div>
    </div>
  </section>

  <!-- Contributing -->
  <section class="container-wide section-padding-sm">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="text-2xl font-bold text-surface-900 mb-4">Contributing</h2>
        <p class="text-surface-600 mb-4">We're looking for:</p>
        <ul class="space-y-3 mb-6">
          <li class="flex items-start gap-3">
            <span class="text-warm-600 font-bold">→</span>
            <span class="text-surface-700"><strong>Engineers</strong> — Python, TypeScript, orchestration, infra, security</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-warm-600 font-bold">→</span>
            <span class="text-surface-700"><strong>UX/Product</strong> — Flows that don't treat people like stats</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-warm-600 font-bold">→</span>
            <span class="text-surface-700"><strong>Clinicians/Researchers</strong> — To design and evaluate NOUS responsibly</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-warm-600 font-bold">→</span>
            <span class="text-surface-700"><strong>Writers/Educators</strong> — Accessible skills content and docs</span>
          </li>
        </ul>
        <p class="text-surface-500 text-sm">
          Early-stage work with room to shape direction. If you like building something meaningful, reach out.
        </p>
      </div>
      <div class="bg-gradient-to-br from-warm-100 to-warm-50 rounded-md p-8 border border-warm-200">
        <h3 class="font-semibold text-surface-900 mb-4">Mental Health Disclaimer</h3>
        <p class="text-surface-600 mb-4 text-sm">
          NOUS and any related tools do <strong>not</strong> replace professional mental health care, 
          do <strong>not</strong> provide crisis intervention, and should <strong>never</strong> be your 
          only support in a life-threatening situation.
        </p>
        <p class="text-surface-700 font-medium text-sm">
          If you are in immediate danger or crisis, contact your local emergency number or a 
          trusted crisis hotline in your region.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="container-wide section-padding-sm">
    <div class="border-t border-surface-200 pt-12 max-w-xl">
      <h2 class="text-2xl font-bold text-surface-900 mb-3">Want to help?</h2>
      <p class="text-surface-600 mb-6">
        AI can serve people without selling them first. We're proving it.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="https://github.com/Daedalus-Landed" target="_blank" rel="noopener noreferrer" class="btn-primary">
          GitHub Organization →
        </a>
        <a href="/contact?subject=Daedalus%20Landed%20Contribution" class="btn-secondary">
          Get Involved
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
