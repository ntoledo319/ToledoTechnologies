---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SampleDiscoveryInsert from '../components/SampleDiscoveryInsert.astro';
import { breadcrumbSchema, itemListSchema } from '../utils/jsonld';

const notes = (await getCollection('case-studies')).sort(
  (a, b) =>
    new Date(b.data.publishedDate).getTime() -
    new Date(a.data.publishedDate).getTime()
);

const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Proof Ledger', url: '/portfolio' }
  ]),
  itemListSchema(
    notes.map((note) => ({
      name: note.data.title,
      url: `/case-studies/${note.slug}/`,
      description: note.data.description
    })),
    'Independent Research Notes'
  )
];

const evidenceRules = [
  {
    mark: 'A',
    title: 'Research note',
    body: 'A dated analysis of public evidence. It is not presented as a paid engagement, private audit, or client outcome.'
  },
  {
    mark: 'B',
    title: 'Sample deliverable',
    body: 'A clearly labeled example of the artifact a discovery can produce. It contains no invented client provenance.'
  }
];
---

<BaseLayout
  title="Proof Ledger"
  description="Inspectable reference builds, independent research notes, and labeled sample deliverables from Toledo Technologies."
  jsonLd={jsonLd}
  realmGlow="0.75 0.15 140"
  realmBg="0.985 0.008 45"
  realmText="0.11 0.03 45"
>
  <section class="proof-ledger-hero border-b border-black/5">
    <div class="container-wide section-padding">
      <Breadcrumbs
        items={[{ label: 'Home', href: '/' }, { label: 'Proof Ledger' }]}
      />
      <div class="proof-ledger-heading">
        <p class="proof-kicker">Toledo Technologies · evidence pressing 001</p>
        <h1>Proof, with the <em>labels left on.</em></h1>
        <p class="proof-deck">
          This ledger separates what was observed from what is only a sample. No
          project count, deployment claim, or client story is implied — every
          note says where the data came from and what it cannot establish.
        </p>
        <div class="cta-actions flex flex-wrap gap-4">
          <a href="/case-studies/" class="btn-primary">Read the field notes</a>
          <a href="/discovery/" class="btn-ghost">Choose a discovery</a>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-black/5">
    <div class="container-wide section-padding-sm">
      <div class="proof-grooves" aria-label="Evidence label key">
        {
          evidenceRules.map((rule) => (
            <article class="proof-groove">
              <span class="proof-groove-mark" aria-hidden="true">
                {rule.mark}
              </span>
              <div>
                <h2>{rule.title}</h2>
                <p>{rule.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b border-black/5">
    <div class="container-wide section-padding-sm">
      <div class="archive-tracklist-heading">
        <div>
          <p class="proof-kicker">Side A · research notes</p>
          <h2>Public research you can inspect</h2>
        </div>
        <p>
          Independent analysis of public sites — not client work. Each note
          states its measurement window and what it cannot establish.
        </p>
      </div>

      <ol class="archive-tracklist">
        {
          notes.map((note, index) => (
            <li>
              <a href={`/case-studies/${note.slug}/`} class="archive-track">
                <span class="archive-track-number">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span class="archive-track-copy">
                  <span class="archive-track-meta">
                    {note.data.evidenceType === 'independent-research'
                      ? 'Independent research'
                      : 'Sample deliverable'}{' '}
                    · {note.data.industry}
                  </span>
                  <strong>{note.data.title}</strong>
                  <span>{note.data.description}</span>
                </span>
                <span class="archive-track-arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <SampleDiscoveryInsert />

  <section>
    <div class="container-wide section-padding-sm">
      <div class="proof-ledger-cta">
        <p class="proof-kicker">Your system will have its own evidence</p>
        <h2>Need a custom build?</h2>
        <p>
          Start with the business problem and the operating constraints. A web
          application build begins at $15K; discovery is scoped separately when
          the unknowns need to be resolved first.
        </p>
        <a
          href="/contact?service=Custom%20Build&subject=Custom%20system%20inquiry"
          class="btn-primary"
        >
          Describe the system
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
