---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { breadcrumbSchema, itemListSchema } from '../utils/jsonld';

const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Portfolio', url: '/portfolio' }
  ]),
  itemListSchema([
    { name: 'ComplyCrawl', url: '/codebases/complycrawl', description: 'Compliance-first web automation' },
    { name: 'TallySec', url: '/codebases/tallysec', description: 'Security training platform' },
    { name: 'AegisTwin', url: '/codebases/aegistwin', description: 'Agent runtime + governance' }
  ], 'Portfolio Projects')
];

const forSaleProjects = [
  {
    name: 'ComplyCrawl',
    category: 'Compliance Automation',
    description: 'Automated compliance evidence collection and web automation for SOC 2, ISO 27001, and GDPR.',
    highlights: ['Evidence Collection', 'Audit Trails', 'Policy Mapping'],
    stack: 'Python, Playwright, PostgreSQL',
    price: 8000
  },
  {
    name: 'TallySec',
    category: 'Security Education',
    description: 'Interactive security training platform with gamified lessons, quizzes, and progress tracking.',
    highlights: ['Gamified Training', 'Progress Analytics', 'Custom Content'],
    stack: 'TypeScript, React, Node.js, MongoDB',
    price: 6500
  },
  {
    name: 'AegisTwin',
    category: 'AI Infrastructure',
    description: 'Agent runtime environment with governance, observability, and safety guardrails.',
    highlights: ['Agent Runtime', 'Governance', 'Observability'],
    stack: 'Python, FastAPI, Redis, Docker',
    price: 4000
  }
];

const activeProjects = [
  { name: 'Daedalus Landed', category: 'Nonprofit', description: 'Free AI tools for mental health, creation, and education.', stack: 'TypeScript, Python, OpenAI' },
  { name: 'Legacy System Rescue', category: 'Consulting', description: 'Modernized a 15-year-old PHP monolith into microservices.', stack: 'PHP, Go, Kubernetes' },
  { name: 'Startup MVP Launch', category: 'MVP', description: 'Built and shipped a fintech MVP in 6 weeks.', stack: 'TypeScript, React, Plaid API' },
  { name: 'Compliance Automation', category: 'Automation', description: 'Automated SOC 2 evidence collection saving 40 hours/month.', stack: 'Python, AWS Lambda' },
  { name: 'Security Audit Platform', category: 'Security', description: 'Internal security audit tracking and remediation workflow.', stack: 'TypeScript, Next.js, Prisma' },
  { name: 'AI Workflow Engine', category: 'AI', description: 'Custom LLM pipeline for automated content generation.', stack: 'Python, LangChain, Vector DB' }
];

const stats = [
  { value: '26+', label: 'Projects Built' },
  { value: '3', label: 'For Sale' },
  { value: '5', label: 'Languages' },
  { value: '10K+', label: 'Functions' }
];
---

<BaseLayout
  title="Portfolio"
  description="26+ production-ready projects built by Toledo Technologies. AI infrastructure, compliance automation, security education, mobile apps, and more."
  jsonLd={jsonLd}
  realmGlow="0.75 0.15 140"
  realmBg="0.10 0.02 160"
  realmText="0.98 0.02 160"
>
  <!-- Hero -->
  <section class="border-b border-white/5 relative overflow-hidden">
    <div class="container-wide section-padding relative z-10">
      <div class="max-w-4xl">
        <Breadcrumbs items={[
          { label: 'Home', href: '/' },
          { label: 'Portfolio' },
        ]} />
        <h1 class="text-6xl sm:text-8xl font-bold mb-8 tracking-tight leading-[0.85]">
          26+ Projects. <span class="text-brand-400 italic">One Builder.</span>
        </h1>
        <p class="text-xl sm:text-2xl opacity-60 mb-12 max-w-2xl leading-relaxed">
          Every project here is complete, documented, and deployable. 
          Three are for sale. The rest are proof of absolute execution.
        </p>
        <div class="flex flex-wrap gap-6">
          <a href="/codebases" class="btn-primary text-lg px-10 py-4 shadow-engine-glow">
            Buy a Codebase
          </a>
          <a href="/contact?subject=Custom%20Build" class="btn-ghost text-lg px-10 py-4">
            Hire for Custom Build
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-b border-white/5">
    <div class="container-wide section-padding-sm">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-12 md:gap-8">
        {stats.map(stat => (
          <div>
            <div class="text-5xl sm:text-6xl font-bold">{stat.value}</div>
            <div class="text-xs uppercase tracking-widest opacity-40 mt-3">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- For Sale -->
  <section class="border-b border-white/5">
    <div class="container-wide section-padding-sm">
      <div class="flex items-center gap-4 mb-12">
        <span class="text-xs font-bold text-brand-400 uppercase tracking-widest">Available</span>
        <h2 class="text-4xl font-bold">Featured Codebases</h2>
      </div>
      <div class="divide-y divide-white/5">
        {forSaleProjects.map(project => (
          <a href={`/codebases/${project.name.toLowerCase()}`} class="group flex items-start justify-between gap-8 py-10 transition-all duration-300 hover:text-brand-400">
            <div class="max-w-3xl">
              <div class="flex items-center gap-4 mb-3">
                <span class="text-xs font-bold opacity-40 uppercase tracking-widest">{project.category}</span>
                <span class="text-xs font-bold opacity-40">Buy Outright</span>
              </div>
              <h3 class="text-2xl sm:text-3xl font-bold mb-3">{project.name}</h3>
              <p class="text-lg opacity-60 mb-4 leading-relaxed group-hover:opacity-80 transition-opacity">{project.description}</p>
              <div class="flex flex-wrap gap-x-4 gap-y-2">
                {project.highlights.map(h => (
                  <span class="text-sm opacity-40">{h}</span>
                ))}
              </div>
            </div>
            <div class="text-right shrink-0">
              <div class="text-3xl font-bold">${project.price.toLocaleString()}</div>
              <div class="text-sm opacity-30 mt-1 font-mono">{project.stack}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Active Projects -->
  <section class="border-b border-white/5">
    <div class="container-wide section-padding-sm">
      <div class="flex items-center gap-4 mb-12">
        <span class="text-xs font-bold opacity-30 uppercase tracking-widest">Archive</span>
        <h2 class="text-4xl font-bold">Proof of Build</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-x-12 gap-y-10">
        {activeProjects.map(project => (
          <div>
            <div class="flex items-baseline justify-between mb-2">
              <h3 class="text-xl font-bold">{project.name}</h3>
              <span class="text-xs font-mono opacity-30 uppercase tracking-widest">{project.category}</span>
            </div>
            <p class="text-sm opacity-50 mb-3 leading-relaxed">{project.description}</p>
            <div class="text-xs font-mono opacity-30 uppercase tracking-wider">{project.stack}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section>
    <div class="container-wide section-padding">
      <div class="max-w-4xl">
        <h2 class="text-4xl font-bold mb-6">Need something custom?</h2>
        <p class="text-xl opacity-60 mb-10 max-w-2xl leading-relaxed">
          I've built 26 projects across AI, security, mobile, web, and systems. 
          If you have a high-stakes problem, let's build the solution.
        </p>
        <div class="flex flex-wrap gap-6">
          <a href="/contact?subject=Custom%20Build" class="btn-primary text-xl px-12 py-5 shadow-engine-glow">
            Start a Custom Build — $15K+
          </a>
          <a href="/codebases" class="btn-ghost text-xl px-12 py-5">
            Buy Existing Code
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
