---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd: object[] = [];
---

<BaseLayout
  title="Thank You for Your Purchase"
  description="Your codebase purchase is confirmed. Here's what happens next."
  jsonLd={jsonLd}
  realmGlow="0.65 0.18 140"
  realmBg="0.10 0.02 150"
  realmText="0.98 0.02 150"
>
  <section class="container-wide section-padding">
    <div class="mx-auto max-w-2xl text-center">
      <div
        class="mx-auto mb-8 flex h-20 w-20 items-center justify-center rounded-full border border-white/10"
      >
        <svg
          class="text-brand-400 h-10 w-10"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M5 13l4 4L19 7"></path>
        </svg>
      </div>
      <h1 class="mb-6 text-5xl font-bold tracking-tight sm:text-6xl">
        Purchase Confirmed
      </h1>
      <p class="mb-12 text-xl leading-relaxed opacity-50">
        Thanks for buying. You'll receive an email within 24 hours with
        repository access and transfer details.
      </p>

      <div class="mb-12 text-left">
        <h2 class="mb-6 text-xl font-bold">What happens next:</h2>
        <ol class="space-y-5 opacity-60">
          <li class="flex gap-4">
            <span class="text-warm-500 text-lg font-bold">1</span>
            <span>We verify the payment (usually instant).</span>
          </li>
          <li class="flex gap-4">
            <span class="text-warm-500 text-lg font-bold">2</span>
            <span
              >You get an email with GitHub repo access and documentation.</span
            >
          </li>
          <li class="flex gap-4">
            <span class="text-warm-500 text-lg font-bold">3</span>
            <span
              >We schedule a 30-minute handoff call to answer questions.</span
            >
          </li>
          <li class="flex gap-4">
            <span class="text-warm-500 text-lg font-bold">4</span>
            <span>IP transfer documents are signed and delivered.</span>
          </li>
        </ol>
      </div>

      <div class="flex flex-wrap justify-center gap-6">
        <a href="/codebases/" class="btn-primary px-10 py-4 text-lg">
          Browse More Codebases
        </a>
        <a href="/portfolio" class="btn-ghost px-10 py-4 text-lg">
          See Our Portfolio
        </a>
      </div>

      <p class="mt-10 text-sm opacity-20">
        Questions? Email <a
          href="mailto:hello@toledotechnologies.com"
          class="text-warm-400 hover:underline">hello@toledotechnologies.com</a
        >
      </p>
    </div>
  </section>
</BaseLayout>
