---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Codebase Checkout Retired"
  description="The former Toledo Technologies codebase checkout is no longer active."
  noindex={true}
  realmGlow="0.65 0.18 140"
  realmBg="0.985 0.008 45"
  realmText="0.11 0.03 45"
>
  <section class="container-wide section-padding">
    <div class="mx-auto max-w-2xl">
      <p class="proof-kicker">Archived route · no transaction processed</p>
      <h1 class="mb-6 text-5xl font-bold tracking-tight sm:text-6xl">
        This checkout is retired.
      </h1>
      <p class="mb-6 text-xl leading-relaxed opacity-70">
        Toledo Technologies no longer sells or licenses the archived codebases
        through this website. Reaching this page does not confirm a purchase,
        payment, repository transfer, or support entitlement.
      </p>
      <p class="mb-10 leading-relaxed opacity-60">
        If a payment processor sent you here unexpectedly, do not submit another
        payment. Email the address below with the processor receipt so the
        transaction can be checked.
      </p>
      <div class="cta-actions flex flex-wrap gap-4">
        <a href="/codebases/" class="btn-primary">View the reference archive</a>
        <a
          href="/contact?subject=Archived%20checkout%20question"
          class="btn-ghost"
        >
          Ask about this route
        </a>
      </div>
      <p class="mt-10 text-sm opacity-50">
        <a href="mailto:hello@toledotechnologies.com"
          >hello@toledotechnologies.com</a
        >
      </p>
    </div>
  </section>
</BaseLayout>
