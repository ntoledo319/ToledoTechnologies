---
import InsertLayout from '../../layouts/InsertLayout.astro';
import { getCollection, render } from 'astro:content';
import { breadcrumbSchema, blogPostingSchema } from '../../utils/jsonld';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Blog', url: '/blog' },
    { name: post.data.title, url: `/blog/${post.id}` }
  ]),
  blogPostingSchema({
    title: post.data.title,
    description: post.data.description,
    url: `/blog/${post.id}`,
    publishedDate: post.data.publishedDate.toISOString(),
    modifiedDate: post.data.modifiedDate?.toISOString(),
    author: post.data.author
  })
];

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  }).format(date);
}

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id)
  .filter((p) => p.data.tags.some((tag) => post.data.tags.includes(tag)))
  .slice(0, 3);
---

<InsertLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  publishedTime={post.data.publishedDate.toISOString()}
  modifiedTime={post.data.modifiedDate?.toISOString()}
  author={post.data.author}
  jsonLd={jsonLd}
>
  <header class="mb-12 border-b border-black/5 pb-8">
    <div class="mb-6 flex flex-wrap items-center gap-4">
      <time
        class="text-sm opacity-75"
        datetime={post.data.publishedDate.toISOString()}
      >
        {formatDate(post.data.publishedDate)}
      </time>
      <span class="opacity-20">•</span>
      <span class="text-sm opacity-75">{post.data.author}</span>
    </div>

    <p class="mb-8 text-xl leading-relaxed opacity-75 sm:text-2xl">
      {post.data.description}
    </p>

    {
      post.data.tldr && (
        <p class="mb-8 max-w-2xl text-base">
          <span class="text-brand-700 mr-2 text-xs font-bold tracking-widest uppercase">
            TL;DR
          </span>
          {post.data.tldr}
        </p>
      )
    }

    <div class="flex flex-wrap gap-3">
      {
        post.data.tags.map((tag) => (
          <a
            href={`/blog/tag/${tag}`}
            class="hover:text-warm-600 text-xs transition-colors"
          >
            {tag}
          </a>
        ))
      }
    </div>
  </header>

  <div class="prose prose-lg max-w-none">
    <Content />
  </div>

  {
    relatedPosts.length > 0 && (
      <section class="mt-20 border-t border-black/5 pt-12">
        <h2
          class="mb-8 text-xl font-bold tracking-widest uppercase opacity-75"
          style="font-family: var(--font-lyric);"
        >
          Related Posts
        </h2>
        <div class="space-y-8">
          {relatedPosts.map((related) => (
            <a
              href={`/blog/${related.id}`}
              class="group hover:text-warm-500 block transition-all duration-300"
            >
              <h3
                class="group-hover:text-warm-500 mb-2 text-lg font-bold transition-colors"
                style="font-family: var(--font-lyric);"
              >
                {related.data.title}
              </h3>
              <p class="text-sm leading-relaxed opacity-75 transition-opacity group-hover:opacity-100">
                {related.data.description}
              </p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <section class="mt-20 border-t border-black/5 pt-12">
    <h2 class="mb-3 text-2xl font-bold" style="font-family: var(--font-lyric);">
      Need this kind of work done?
    </h2>
    <p class="mb-6 opacity-75">
      We write about what we actually do. If this resonated, let's talk.
    </p>
    <a href="/contact" class="btn-primary">Get a Quote</a>
  </section>
</InsertLayout>
