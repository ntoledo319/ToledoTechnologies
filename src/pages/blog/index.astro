---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { breadcrumbSchema, itemListSchema } from '../../utils/jsonld';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => 
  new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime()
);

const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Blog', url: '/blog' }
  ]),
  itemListSchema(
    sortedPosts.map(p => ({
      name: p.data.title,
      url: `/blog/${p.slug}`,
      description: p.data.description
    })),
    'Toledo Technologies Blog'
  )
];

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  }).format(date);
}
---

<BaseLayout
  title="Blog"
  description="Practical insights on software development, performance optimization, bug fixes, compliance automation, and shipping software that works."
  jsonLd={jsonLd}
  realmGlow="0.58 0.12 210"
  realmBg="0.12 0.01 220"
  realmText="0.98 0.01 220"
>
  <!-- Hero -->
  <section class="border-b border-white/5 relative overflow-hidden">
    <div class="container-wide section-padding-sm relative z-10">
      <div class="max-w-4xl">
        <Breadcrumbs items={[
          { label: 'Home', href: '/' },
          { label: 'Blog' },
        ]} />
        <h1 class="text-5xl sm:text-7xl font-bold mb-6 tracking-tight leading-[0.9]">
          The <span class="text-brand-400 italic">Blog</span>
        </h1>
        <p class="text-xl sm:text-2xl opacity-70 max-w-2xl leading-relaxed">
          What we've learned from fixing other people's code, shipping under pressure,
          and automating things that should have been automated years ago.
        </p>
      </div>
    </div>
  </section>

  <!-- Posts Grid -->
  <section class="container-wide section-padding-sm">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {sortedPosts.map((post, index) => (
        <a 
          href={`/blog/${post.slug}`}
          class:list={[
            "card-interactive p-8 group flex flex-col",
            index === 0 && "md:col-span-2 lg:col-span-2"
          ]}
        >
          <div class="flex items-center gap-4 mb-4">
            <time class="text-sm opacity-50" datetime={post.data.publishedDate.toISOString()}>
              {formatDate(post.data.publishedDate)}
            </time>
            {post.data.featured && (
              <span class="text-xs font-bold px-3 py-1 rounded-full bg-brand-500/20 text-brand-400 border border-brand-500/30">
                Featured
              </span>
            )}
          </div>
          <h2 class:list={[
            "font-bold group-hover:text-warm-500 transition-colors mb-3 leading-tight",
            index === 0 ? "text-3xl" : "text-xl"
          ]}>
            {post.data.title}
          </h2>
          <p class:list={[
            "opacity-70 mb-6 flex-grow leading-relaxed",
            index === 0 ? "text-lg" : "text-base"
          ]}>
            {post.data.description}
          </p>
          {post.data.tldr && index === 0 && (
            <div class="bg-white/5 rounded-engine-inner p-6 mb-6 border border-white/10">
              <span class="text-xs font-bold opacity-40 uppercase tracking-widest">TL;DR</span>
              <p class="text-sm opacity-80 mt-2 leading-relaxed">{post.data.tldr}</p>
            </div>
          )}
          <div class="flex flex-wrap gap-2">
            {post.data.tags.slice(0, 3).map((tag) => (
              <span class="text-xs px-3 py-1 rounded-full bg-white/10 opacity-60 hover:bg-warm-500/20 hover:text-warm-400 transition-colors">
                {tag}
              </span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="container-wide section-padding-sm">
    <div class="max-w-4xl mx-auto text-center p-16 rounded-engine bg-surface-900/40 backdrop-blur-md border border-white/10 shadow-engine-glow">
      <h2 class="text-4xl font-bold mb-6">Need this kind of work done?</h2>
      <p class="text-xl opacity-70 mb-10 max-w-2xl mx-auto leading-relaxed">
        Everything we write about, we do for clients. Tell us what's broken.
      </p>
      <div class="flex flex-wrap justify-center gap-6">
        <a href="/contact" class="btn-primary text-lg px-10 py-4 shadow-engine-glow">Get a Quote</a>
        <a href="/services" class="btn-secondary text-lg px-10 py-4">View Services</a>
      </div>
    </div>
  </section>
</BaseLayout>
