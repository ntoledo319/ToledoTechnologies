---
import InsertLayout from '../../layouts/InsertLayout.astro';
import { breadcrumbSchema } from '../../utils/jsonld';

const jsonLd = breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Tools', url: '/tools' },
  { name: 'Site Speed Test', url: '/tools/speed-test' }
]);
---

<InsertLayout
  title="Site Speed Test"
  description="Open a public URL in Google PageSpeed Insights, then use a plain-language guide to read the lab and field measurements."
  jsonLd={jsonLd}
  heading="Site Speed Test"
  subheading="Send a public URL to Google PageSpeed Insights. No Toledo form submission or account required."
>
  <div class="audit-launcher">
    <label for="urlInput">Public page URL</label>
    <div class="input-row">
      <input
        id="urlInput"
        type="url"
        inputmode="url"
        placeholder="https://example.com"
        autocomplete="url"
        spellcheck="false"
      />
      <button id="auditBtn" type="button">Open PageSpeed</button>
    </div>
    <p id="status" class="status" aria-live="polite">
      The result opens on pagespeed.web.dev in a new tab.
    </p>
  </div>

  <h2>What the report separates</h2>
  <ol class="measurement-tracklist">
    <li>
      <strong>Lab data</strong>
      <span>
        A synthetic Lighthouse run under a defined device and network profile.
        It is useful for repeatable diagnosis, not a claim about every visitor.
      </span>
    </li>
    <li>
      <strong>Field data</strong>
      <span>
        Aggregated Chrome User Experience data when the tested page or origin
        has enough eligible traffic. New or low-traffic pages may show none.
      </span>
    </li>
    <li>
      <strong>Opportunities</strong>
      <span>
        Tool-generated diagnostics. Treat them as leads to verify in the actual
        application, not a guaranteed fix list or conversion forecast.
      </span>
    </li>
  </ol>

  <h2>Reading the headline numbers</h2>
  <div
    class="data-table-scroll"
    role="region"
    aria-label="Performance measurement thresholds; scroll horizontally on a small screen"
    tabindex="0"
  >
    <table>
      <thead>
        <tr>
          <th>Measure</th>
          <th>Good</th>
          <th>Needs improvement</th>
          <th>Poor</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Lighthouse performance score</td>
          <td>90–100</td>
          <td>50–89</td>
          <td>0–49</td>
        </tr>
        <tr>
          <td>Largest Contentful Paint</td>
          <td>≤ 2.5s</td>
          <td>&gt; 2.5s to 4.0s</td>
          <td>&gt; 4.0s</td>
        </tr>
      </tbody>
    </table>
  </div>
  <p class="table-scroll-hint">
    On a small screen, swipe the table sideways to read every column.
  </p>
  <p class="measurement-note">
    These are diagnostic categories used by Lighthouse and Core Web Vitals, not
    promises about ranking, bounce rate, revenue, or the result of an
    optimization engagement.
  </p>

  <h2>When the free report is not enough</h2>
  <p>
    A SiteLift Fit Check is a separate $750 engagement. It adds a human read,
    written constraints, a prioritized migration or repair route, and a quote
    basis. The public PageSpeed run above is only one input.
  </p>
  <p>
    <a href="/discovery/#sitelift-fit-check">Read the Fit Check scope →</a><br
    />
    <a href="/case-studies/">Inspect labeled research and sample evidence →</a>
  </p>

  <p class="measurement-note">
    Privacy note: this page does not submit the URL to Toledo Technologies.
    Selecting the button opens Google PageSpeed Insights, where Google's terms
    and privacy practices apply.
  </p>
</InsertLayout>

<style>
  .audit-launcher {
    border-block: 1px solid rgba(0, 0, 0, 0.14);
    padding: 2rem 0;
    margin: 2rem 0;
  }
  .audit-launcher label {
    display: block;
    margin-bottom: 0.6rem;
    font-family: var(--gf-font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .input-row {
    display: flex;
    gap: 0.65rem;
  }
  .input-row input {
    flex: 1;
    min-width: 0;
    min-height: 48px;
    box-sizing: border-box;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    background: rgba(0, 0, 0, 0.035);
    border: 1px solid rgba(0, 0, 0, 0.2);
    color: inherit;
    font-family: var(--gf-font-mono);
  }
  .input-row button {
    min-height: 48px;
    padding: 0.75rem 1.2rem;
    font: 700 0.86rem/1 var(--gf-font-mono);
    border: 1px solid var(--gf-ink-900);
    background: var(--gf-ink-900);
    color: var(--gf-paper-50);
    cursor: pointer;
  }
  .input-row button:hover {
    background: var(--gf-accent-deep);
    border-color: var(--gf-accent-deep);
  }
  .status,
  .measurement-note {
    margin-top: 0.75rem !important;
    font-size: 0.88rem !important;
    opacity: 0.68;
  }
  .measurement-tracklist {
    list-style: none;
    padding: 0;
    margin: 2rem 0;
    border-top: 1px solid rgba(0, 0, 0, 0.14);
  }
  .measurement-tracklist li {
    display: grid;
    grid-template-columns: minmax(9rem, 0.7fr) 2fr;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.14);
  }
  .measurement-tracklist strong {
    font-family: var(--gf-font-display);
  }
  table {
    width: 100%;
    min-width: 36rem;
    margin: 1rem 0;
    border-collapse: collapse;
    font-size: 0.9em;
  }
  th,
  td {
    padding: 0.65rem 0.8rem;
    text-align: left;
    border-bottom: 1px solid rgba(0, 0, 0, 0.12);
    vertical-align: top;
  }
  th {
    font-family: var(--gf-font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.04em;
  }
  @media (max-width: 640px) {
    .input-row {
      flex-direction: column;
    }
    .measurement-tracklist li {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>

<script>
  const input = document.getElementById('urlInput') as HTMLInputElement | null;
  const button = document.getElementById(
    'auditBtn'
  ) as HTMLButtonElement | null;
  const status = document.getElementById('status');

  function openPageSpeed(): void {
    if (!input || !status) return;

    try {
      const url = new URL(input.value.trim());
      if (!['http:', 'https:'].includes(url.protocol)) {
        throw new Error('unsupported protocol');
      }

      const destination = `https://pagespeed.web.dev/analysis?url=${encodeURIComponent(url.toString())}`;
      window.open(destination, '_blank', 'noopener,noreferrer');
      status.textContent = 'PageSpeed Insights opened in a new tab.';
    } catch {
      status.textContent =
        'Enter a complete public URL beginning with http:// or https://.';
      input.focus();
    }
  }

  button?.addEventListener('click', openPageSpeed);
  input?.addEventListener('keydown', (event: KeyboardEvent) => {
    if (event.key === 'Enter') openPageSpeed();
  });
</script>
