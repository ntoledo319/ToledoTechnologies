---
import InsertLayout from '../../layouts/InsertLayout.astro';
import { breadcrumbSchema } from '../../utils/jsonld';

const jsonLd = breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Tools', url: '/tools' },
  { name: 'Training Platform Cost Model', url: '/tools/bootcamp-roi' }
]);
---

<InsertLayout
  title="Training Platform Cost Model"
  description="Compare a per-seat training subscription with an estimated custom platform budget using your own inputs."
  jsonLd={jsonLd}
  heading="Training Platform Cost Model"
  subheading="A planning calculator, not a product checkout or vendor-price claim."
>
  <p>
    Use your current vendor quote and a realistic custom-build budget to compare
    simple cash cost. This model does not estimate content production,
    maintenance, hosting, migration, financing, or opportunity cost.
  </p>

  <div class="roi-tool">
    <div class="inputs">
      <label>
        Learners in year one
        <input
          id="learners"
          type="number"
          value="100"
          min="1"
          max="100000"
          step="1"
        />
      </label>
      <label>
        Quoted annual price per learner ($)
        <input
          id="seatCost"
          type="number"
          value="0"
          min="0"
          max="1000000000"
          step="10"
        />
        <small>Enter the number from your own vendor quote.</small>
      </label>
      <label>
        Years to model
        <input id="years" type="number" value="3" min="1" max="10" step="1" />
      </label>
      <label>
        Expected annual learner growth (%)
        <input
          id="growth"
          type="number"
          value="0"
          min="-100"
          max="500"
          step="1"
        />
      </label>
      <label>
        Estimated custom build budget ($)
        <input
          id="buildCost"
          type="number"
          value="65000"
          min="0"
          max="1000000000"
          step="1000"
        />
        <small
          >Use a scoped quote when you have one; $65K is only an editable
          starting input.</small
        >
      </label>
    </div>

    <div
      class="output data-table-scroll"
      id="output"
      role="region"
      aria-label="Training cost comparison; scroll horizontally on a small screen"
      tabindex="0"
    >
    </div>
    <p class="table-scroll-hint">
      On a small screen, swipe the comparison sideways to read every column.
    </p>
    <p
      id="comparison-summary"
      class="sr-only"
      aria-live="polite"
      aria-atomic="true"
    >
    </p>
  </div>

  <p class="model-note">
    The comparison is illustrative and deliberately incomplete. A custom system
    normally has continuing operating costs; a subscription may include content,
    support, compliance work, and product updates that a custom build does not.
    No option is declared cheaper until your real inputs and full operating
    model say so.
  </p>

  <p>
    <a href="/discovery/#web-app-discovery" class="btn-primary">
      Scope an application discovery →
    </a>
  </p>
</InsertLayout>

<style>
  .roi-tool {
    border-block: 1px solid rgba(0, 0, 0, 0.14);
    padding: 2rem 0;
    margin: 2rem 0;
  }
  .inputs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  .inputs label {
    display: flex;
    min-width: 0;
    flex-direction: column;
    font-size: 0.95em;
    font-weight: 600;
  }
  .inputs input {
    width: 100%;
    min-height: 44px;
    box-sizing: border-box;
    margin-top: 0.4rem;
    padding: 0.7rem 0.8rem;
    font-size: 1.05em;
    background: rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(0, 0, 0, 0.18);
    color: inherit;
    font-family: var(--gf-font-mono);
  }
  .inputs small {
    opacity: 0.65;
    margin-top: 0.4rem;
    font-size: 0.8em;
    font-weight: 400;
  }
  .output {
    padding: 1.5rem 0;
    font-family: var(--gf-font-mono);
    line-height: 1.7;
  }
  .output :global(table) {
    width: 100%;
    min-width: 32rem;
    margin-top: 0.8rem;
    border-collapse: collapse;
    font-size: 0.9em;
  }
  .output :global(th),
  .output :global(td) {
    padding: 0.6rem 0.8rem;
    text-align: right;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }
  .output :global(th:first-child),
  .output :global(td:first-child) {
    text-align: left;
  }
  .output :global(.comparison) {
    display: block;
    margin-top: 1rem;
    color: var(--gf-accent-deep);
    font-weight: 700;
  }
  .model-note {
    font-size: 0.9em !important;
    opacity: 0.72;
  }
</style>

<script>
  import { calculateTrainingCostModel } from '../../utils/trainingCostModel';

  function fmt(n: number): string {
    return '$' + Math.round(n).toLocaleString();
  }

  function numericValue(id: string): number {
    const input = document.getElementById(id) as HTMLInputElement | null;
    return input?.value.trim() ? Number(input.value) : Number.NaN;
  }

  let announcementTimer: number | undefined;

  function recompute(): void {
    const result = calculateTrainingCostModel({
      learners: numericValue('learners'),
      seatCost: numericValue('seatCost'),
      years: numericValue('years'),
      growthPercent: numericValue('growth'),
      buildCost: numericValue('buildCost')
    });
    const {
      years,
      buildCost,
      annualSubscriptionCosts,
      subscriptionTotal,
      difference
    } = result;
    const comparison =
      difference === 0
        ? 'The entered base costs are equal.'
        : difference > 0
          ? `The entered subscription base cost is ${fmt(difference)} higher.`
          : `The entered custom-build base cost is ${fmt(Math.abs(difference))} higher.`;

    const html = `
      <strong>Base-cost comparison over ${years} year${years > 1 ? 's' : ''}</strong>
      <table>
        <thead><tr><th>Approach</th><th>Year 1</th><th>Year ${years}</th><th>${years}-year base</th></tr></thead>
        <tbody>
          <tr><td>Per-seat subscription</td><td>${fmt(annualSubscriptionCosts[0] ?? 0)}</td><td>${fmt(annualSubscriptionCosts.at(-1) ?? 0)}</td><td>${fmt(subscriptionTotal)}</td></tr>
          <tr><td>Custom build estimate</td><td>${fmt(buildCost)}</td><td>Not modeled</td><td>${fmt(buildCost)}</td></tr>
        </tbody>
      </table>
      <span class="comparison">${comparison}</span>
    `;

    const output = document.getElementById('output');
    if (output) output.innerHTML = html;

    const summary = document.getElementById('comparison-summary');
    if (summary) {
      window.clearTimeout(announcementTimer);
      announcementTimer = window.setTimeout(() => {
        summary.textContent = `Cost model updated. ${comparison}`;
      }, 500);
    }
  }

  ['learners', 'seatCost', 'years', 'growth', 'buildCost'].forEach((id) => {
    document.getElementById(id)?.addEventListener('input', recompute);
  });

  recompute();
</script>
