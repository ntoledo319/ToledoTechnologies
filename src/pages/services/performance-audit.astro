---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const auditSteps = [
  {
    step: '01',
    label: 'Baseline',
    value: 'Captured',
    description: 'Record the current environment, workload, and measurements.'
  },
  {
    step: '02',
    label: 'Diagnosis',
    value: 'Traceable',
    description: 'Tie bottlenecks to requests, code paths, assets, or queries.'
  },
  {
    step: '03',
    label: 'Execution',
    value: 'Scoped',
    description: 'Prioritize changes by impact, risk, and implementation cost.'
  },
  {
    step: '04',
    label: 'Re-test',
    value: 'Compared',
    description: 'Measure the same workload again and report the delta.'
  }
];
---

<BaseLayout
  title="Performance Audit"
  description="Measurement-led performance diagnosis for sites and software, with findings, limits, and any implementation scope confirmed in writing."
  realmGlow="0.60 0.25 300"
  realmBg="0.985 0.008 45"
  realmText="0.11 0.03 45"
>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-black/5">
    <div class="container-wide section-padding relative z-10">
      <div class="max-w-4xl">
        <Breadcrumbs
          items={[
            { label: 'Home', href: '/' },
            { label: 'Services', href: '/services' },
            { label: 'Performance Audit' }
          ]}
        />
        <h1
          class="mb-8 text-6xl leading-none font-bold tracking-tighter sm:text-8xl"
        >
          Speed is <span class="text-brand-400 italic">Security.</span>
        </h1>
        <p
          class="mb-12 max-w-2xl text-xl leading-relaxed opacity-50 sm:text-2xl"
        >
          Measurement-led performance work for web applications and sites. The
          audit identifies bottlenecks; any implementation scope says exactly
          which fixes are included.
        </p>
        <div class="flex flex-wrap gap-6">
          <a
            href="/contact?service=Performance%20Audit&subject=Performance%20audit%20inquiry"
            class="btn-primary shadow-engine-glow px-10 py-4 text-lg"
          >
            Ask About Performance Work
          </a>
        </div>
      </div>
    </div>

    <div class="pointer-events-none absolute inset-0 opacity-10">
      <div
        class="via-brand-500 absolute top-1/4 left-0 h-px w-full bg-gradient-to-r from-transparent to-transparent"
      >
      </div>
      <div
        class="via-brand-500 absolute top-2/4 left-0 h-px w-full translate-x-20 bg-gradient-to-r from-transparent to-transparent"
      >
      </div>
      <div
        class="via-brand-500 absolute top-3/4 left-0 h-px w-full -translate-x-20 bg-gradient-to-r from-transparent to-transparent"
      >
      </div>
    </div>
  </section>

  <!-- Audit Flow -->
  <section class="container-wide section-padding-sm">
    <div class="mx-auto max-w-5xl">
      <h2
        class="mb-12 text-center text-3xl font-bold tracking-[0.3em] uppercase opacity-30"
      >
        The Audit Flow
      </h2>
      <div class="grid gap-8 md:grid-cols-4">
        {
          auditSteps.map((step) => (
            <div class="group relative">
              <div class="mb-3 text-xs tracking-widest opacity-20">
                {step.step}
              </div>
              <div class="mb-1 text-sm font-bold uppercase opacity-40">
                {step.label}
              </div>
              <div class="text-brand-400 mb-3 text-2xl font-bold">
                {step.value}
              </div>
              <p class="text-sm leading-relaxed opacity-50">
                {step.description}
              </p>
              <div class="bg-brand-500/20 group-hover:bg-brand-500/60 mt-6 h-px transition-colors duration-700" />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Commercial path -->
  <section class="border-t border-black/5">
    <div class="container-wide section-padding">
      <div class="mx-auto max-w-4xl">
        <h2 class="mb-6 text-4xl font-bold sm:text-5xl">How this is scoped</h2>
        <p class="max-w-3xl text-xl leading-relaxed opacity-60">
          The retired performance-package names and prices previously shown on
          this page are no longer active offers. Current work follows the
          published Strategic / Audit / Consulting rate of $225/hour or a
          written fixed scope. Payment, access, measurements, and delivery
          timing are confirmed before work begins.
        </p>
        <div
          class="mt-10 grid gap-8 border-y border-black/5 py-10 md:grid-cols-3"
        >
          <div>
            <h3 class="mb-3 text-lg font-bold">1. State the symptom</h3>
            <p class="text-sm leading-relaxed opacity-60">
              Share the public URL or environment, the workload, and what
              changed.
            </p>
          </div>
          <div>
            <h3 class="mb-3 text-lg font-bold">2. Confirm evidence access</h3>
            <p class="text-sm leading-relaxed opacity-60">
              We identify which logs, traces, source, and repeatable
              measurements are available.
            </p>
          </div>
          <div>
            <h3 class="mb-3 text-lg font-bold">3. Approve a written scope</h3>
            <p class="text-sm leading-relaxed opacity-60">
              Diagnosis and implementation are separated unless the approved
              scope explicitly combines them.
            </p>
          </div>
        </div>
        <p class="mt-8 text-sm leading-relaxed opacity-55">
          A public PageSpeed result may be a useful input, but it is not itself
          a Toledo audit, outcome promise, or authorization to change a system.
        </p>
      </div>
    </div>
  </section>

  <!-- Final Statement -->
  <section class="border-t border-black/5">
    <div class="container-wide section-padding-sm">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="mb-8 text-3xl font-bold italic opacity-80">
          "We clean up the mess so you can run the business."
        </h2>
        <p class="mb-12 text-xl opacity-40">
          Bring the URL, the workload, and the symptom. The first job is to
          measure what is actually slow.
        </p>
        <a
          href="/contact?service=Performance%20Audit&subject=Performance%20question"
          class="btn-ghost px-12 py-4 text-lg"
        >
          Ask a Question
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
