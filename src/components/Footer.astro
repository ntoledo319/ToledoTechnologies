---
const currentYear = new Date().getFullYear();

const navLinks = [
  { href: '/services', label: 'Services' },
  { href: '/codebases', label: 'Codebases' },
  { href: '/portfolio', label: 'Portfolio' },
  { href: '/case-studies', label: 'Case Studies' },
  { href: '/blog', label: 'Blog' },
  { href: '/nonprofit', label: 'Nonprofit' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const legalLinks = [
  { href: '/privacy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
  { href: '/policies', label: 'Policies' },
];
---

<footer class="bg-surface-900 text-surface-400">
  <div class="container-wide py-12 lg:py-16">
    <!-- Top: monospace identity block -->
    <div class="font-mono text-sm mb-10">
      <a href="/" class="text-white font-bold text-base hover:text-warm-400 transition-colors">
        toledo<span class="text-warm-400">tech</span>
      </a>
      <div class="mt-2 space-y-0.5">
        <p>Remote software development studio</p>
        <p>
          <a href="mailto:hello@toledotechnologies.com" class="hover:text-white transition-colors">
            hello@toledotechnologies.com
          </a>
        </p>
        <p>
          <a href="https://github.com/ntoledo319" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
            github.com/ntoledo319
          </a>
        </p>
      </div>
    </div>

    <!-- Navigation -->
    <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm mb-10">
      {navLinks.map((link) => (
        <a href={link.href} class="hover:text-white transition-colors">
          {link.label}
        </a>
      ))}
    </div>

    <!-- Bottom -->
    <div class="pt-6 border-t border-surface-800 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 text-xs text-surface-500">
      <p>&copy; {currentYear} Toledo Technologies</p>
      <div class="flex gap-4">
        {legalLinks.map((link) => (
          <a href={link.href} class="hover:text-surface-300 transition-colors">
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
