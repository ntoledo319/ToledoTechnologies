---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/services', label: 'Services' },
  { href: '/codebases', label: 'Codebases' },
  { href: '/portfolio', label: 'Portfolio' },
  { href: '/case-studies', label: 'Case Studies' },
  { href: '/blog', label: 'Blog' },
  { href: '/nonprofit', label: 'Nonprofit' },
  { href: '/about', label: 'About' }
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header
  class="bg-surface-50/70 border-surface-900/5 sticky top-0 z-50 border-b backdrop-blur-xl"
>
  <nav class="container-wide" aria-label="Main navigation">
    <div class="flex h-14 items-center justify-between lg:h-16">
      <!-- Logo -->
      <a
        href="/"
        class="group flex items-center gap-2"
        aria-label="Toledo Technologies Home"
      >
        <img
          src="/logo.png"
          alt="Toledo Technologies"
          width="800"
          height="216"
          class="h-7 w-auto sm:h-8"
          decoding="async"
        />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden items-center gap-1 lg:flex">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'rounded-engine-pill px-4 py-2 text-sm font-medium transition-all duration-300',
                isActive(link.href)
                  ? 'bg-surface-500/10 text-current shadow-sm'
                  : 'hover:text-warm-500 hover:bg-surface-500/5 opacity-70 hover:opacity-100'
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </div>

      <!-- CTA + Mobile Menu -->
      <div class="flex items-center gap-3">
        <a href="/contact" class="btn-primary hidden sm:inline-flex">
          Get a Quote
        </a>

        <!-- Mobile Menu Button -->
        <button
          type="button"
          class="text-surface-600 hover:bg-surface-100 rounded-md p-2 transition-colors lg:hidden"
          aria-label="Toggle menu"
          aria-expanded="false"
          id="mobile-menu-button"
        >
          <svg
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"
              id="menu-icon-open"></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"
              id="menu-icon-close"
              class="hidden"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation -->
    <div class="hidden lg:hidden" id="mobile-menu">
      <div class="border-surface-200 space-y-1 border-t py-3">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'block rounded-md px-3 py-2 text-base font-medium transition-colors',
                isActive(link.href)
                  ? 'text-surface-900 bg-surface-100'
                  : 'text-surface-500 hover:text-warm-600 hover:bg-surface-50'
              ]}
            >
              {link.label}
            </a>
          ))
        }
        <div class="px-3 pt-3">
          <a href="/contact" class="btn-primary w-full justify-center">
            Write the Studio
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-icon-open');
  const closeIcon = document.getElementById('menu-icon-close');

  menuButton?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('hidden') === false;
    menuButton.setAttribute('aria-expanded', String(isOpen));
    openIcon?.classList.toggle('hidden', isOpen);
    closeIcon?.classList.toggle('hidden', !isOpen);
  });
</script>
