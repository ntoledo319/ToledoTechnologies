---
/*
 * Cloudflare Web Analytics beacon — single source of truth for every layout.
 *
 * The site tag is a PUBLIC value: it ships in the page source and is visible
 * to every visitor, so it is safe to commit. It is NOT a secret.
 *
 * To switch analytics on, set the token in ONE place — either:
 *   - paste it into CF_BEACON_TOKEN below, or
 *   - set PUBLIC_CF_BEACON_TOKEN in the build environment (.env / CI).
 *
 * This token is the "site_token" of the Cloudflare Web Analytics site created
 * for host toledotechnologies.com (the domain resolves straight to the VPS via
 * Porkbun, so it is not proxied through Cloudflare and needs this manual JS
 * beacon — there is no auto-inject). Manage it at:
 *   dash.cloudflare.com -> Analytics & Logs -> Web Analytics.
 *
 * When no token is set, this renders NOTHING. The site never ships a dead
 * third-party request carrying a placeholder token.
 */

// Public Cloudflare Web Analytics site_token for toledotechnologies.com.
const CF_BEACON_TOKEN = '995219a111fe4d7e909f31238115e36e';

const token = (
  import.meta.env.PUBLIC_CF_BEACON_TOKEN ?? CF_BEACON_TOKEN
).trim();
---

{
  token && (
    <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={JSON.stringify({ token })}
    />
  )
}
