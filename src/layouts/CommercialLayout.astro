---
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/gatefold.css';
import '../styles/commercial.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
import Analytics from '../components/Analytics.astro';
import PolicyNavigationGuard from '../components/PolicyNavigationGuard.astro';
import { ClientRouter } from 'astro:transitions';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  jsonLd?: object | object[];
  pageClass?: string;
}

const {
  title,
  description,
  canonical,
  noindex = false,
  jsonLd,
  pageClass = ''
} = Astro.props;
const siteUrl = import.meta.env.SITE || 'https://toledotechnologies.com';
const canonicalUrl =
  canonical || new URL(Astro.url.pathname, siteUrl).toString();
const fullTitle =
  title === 'Home'
    ? 'Toledo Technologies | Workflow repair, setup, and care'
    : `${title} | Toledo Technologies`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <SEOHead
      title={fullTitle}
      description={description}
      canonical={canonicalUrl}
      noindex={noindex}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <ClientRouter />
    <PolicyNavigationGuard />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      jsonLd &&
        (Array.isArray(jsonLd) ? (
          jsonLd.map((data) => (
            <script
              is:inline
              type="application/ld+json"
              set:html={JSON.stringify(data)}
            />
          ))
        ) : (
          <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(jsonLd)}
          />
        ))
    }
  </head>
  <body class:list={['commercial-body', pageClass]}>
    <a href="#main-content" class="commercial-skip">Skip to content</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
    <Analytics />
  </body>
</html>
